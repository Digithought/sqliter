{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    // `bench/arms.mjs` is deliberately plain JavaScript: the benchmark page loads it straight
    // from a <script type="module"> with no build step. The smoke spec imports that same file,
    // so this pass has to be able to resolve it.
    "allowJs": true,
    "sourceMap": true,
    "types": ["node", "mocha"],
    "noEmit": true
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  // `bench/**/*` is listed because this config is composite: an imported file that is not in
  // the file list is a hard error (TS6307), not an implicit addition.
  "include": ["test/**/*", "src/**/*", "bench/**/*"],
  // Repeated rather than inherited: `extends` replaces `exclude` wholesale, and dropping it
  // here would pull `dist` back into the pass.
  "exclude": ["node_modules", "dist"]
}

