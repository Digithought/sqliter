-- adapted from SQLite test/cast.test, numcast.test, types2.test
-- Edge cases for CAST and conversion functions: BLOB roundtrips, scientific notation,
-- whitespace handling, IEEE 754 INF/NaN.

-- =============================================================================
-- BLOB roundtrips via CAST
-- =============================================================================

-- CAST text to BLOB preserves bytes
select cast('hello' as blob) = x'68656c6c6f' as r;
→ [{"r":true}]

-- BLOB equality after CAST
select cast(x'0102' as blob) = x'0102' as r;
→ [{"r":true}]

-- =============================================================================
-- Scientific notation in conversions
-- =============================================================================

-- CAST string with positive exponent
select cast('1.23e+2' as real) as r;
→ [{"r":123}]

-- CAST string with negative exponent
select cast('5e-1' as real) as r;
→ [{"r":0.5}]

-- =============================================================================
-- Whitespace handling in conversions
-- =============================================================================

-- Leading whitespace
select cast('  42' as integer) as r;
→ [{"r":42}]

select cast('  3.14' as real) as r;
→ [{"r":3.14}]

-- Trailing whitespace
select cast('42  ' as integer) as r;
→ [{"r":42}]

-- =============================================================================
-- BOOLEAN <-> numeric edge cases
-- =============================================================================

-- BOOLEAN-typed literal coerced to integer
select cast(true as integer) + cast(false as integer) as r;
→ [{"r":1}]

-- Negative integer to boolean: nonzero is true
select cast(-1 as boolean) as r;
→ [{"r":true}]

-- Float to boolean
select cast(0.5 as boolean) as r;
→ [{"r":true}]

select cast(0.0 as boolean) as r;
→ [{"r":false}]

-- =============================================================================
-- A failed CAST yields NULL, never the unconverted operand
-- =============================================================================
-- The numeric/text/blob targets keep SQLite's lenient fallbacks (0, '', bytes).
-- Every other target has no such fallback, so a value it cannot convert simply
-- has no result: the cast is NULL rather than a value outside the target type.

select cast('junk' as date) as r;
→ [{"r":null}]

select cast('junk' as time) as r;
→ [{"r":null}]

select cast('junk' as datetime) as r;
→ [{"r":null}]

select cast('junk' as timespan) as r;
→ [{"r":null}]

select cast('junk' as boolean) as r;
→ [{"r":null}]

-- A blob is not a JSON value under any reading, so the cast has no result.
select cast(x'0102' as json) as r;
→ [{"r":null}]

-- But a bare string IS a valid JSON string scalar even though it is not valid
-- JSON *source text*, so JSON's own validate keeps it.
select cast('abc' as json) as r;
→ [{"r":"abc"}]

-- Successful casts are unaffected.
select cast('2024-03-05' as date) as r;
→ [{"r":"2024-03-05"}]

select cast('true' as boolean) as r;
→ [{"r":true}]

-- A blob is not a date under any reading either.
select cast(x'0102' as date) as r;
→ [{"r":null}]

-- Numeric/text/blob fallbacks still apply and still produce their own type.
select cast('junk' as integer) as r;
→ [{"r":0}]

select cast('junk' as real) as r;
→ [{"r":0}]

-- Every fallback arm yields a value that inhabits the type the cast advertises.
-- typeof() reports the storage class, so REAL's 0.0 reads as 'integer'.
select typeof(cast('junk' as integer)) as i, typeof(cast('junk' as real)) as r,
	typeof(cast('junk' as numeric)) as n, typeof(cast(x'0102' as text)) as t,
	typeof(cast('junk' as blob)) as b;
→ [{"i":"integer","r":"integer","n":"integer","t":"text","b":"blob"}]

-- -----------------------------------------------------------------------------
-- Write path: the NULL reaches storage as a NULL, not as garbage
-- -----------------------------------------------------------------------------

create table cast_dt (id integer primary key, dt date null);

insert into cast_dt values (1, cast('junk' as date));
select id, dt, typeof(dt) as ty from cast_dt where id = 1;
→ [{"id":1,"dt":null,"ty":"null"}]

-- A successful cast round-trips through storage unchanged.
insert into cast_dt values (2, cast('2024-03-05' as date));
select id, dt, typeof(dt) as ty from cast_dt where id = 2;
→ [{"id":2,"dt":"2024-03-05","ty":"text"}]

-- The stored date still orders as a date, not as the raw operand would have.
select id from cast_dt where dt > '2000-01-01' order by id;
→ [{"id":2}]

drop table cast_dt;

-- Columns are NOT NULL by default, so the same insert is rejected outright
-- instead of storing a value the column's type does not admit.
create table cast_dt_nn (id integer primary key, dt date not null);

insert into cast_dt_nn values (1, cast('junk' as date));
-- error: NOT NULL constraint failed

drop table cast_dt_nn;
