-- filter-lost-under-index-order.sqllogic - a WHERE conjunct must survive ORDER BY absorption
--
-- Regression guard for `bug-filter-conjunct-lost-under-index-order`. When an
-- ORDER BY is satisfied by the table's own primary-key walk, `rule-grow-retrieve`
-- absorbs the Sort and commits the Retrieve to an index-style access plan. From
-- that point `Retrieve.source` is no longer read at physicalization — so a
-- predicate that `rule-predicate-pushdown` writes into it is silently discarded
-- and the query returns EVERY row. The sub-select conjunct is what forces the
-- residual predicate above the Retrieve where pushdown can re-attack it.
--
-- Invariant pinned here: for each shape, the `order by` variants return the same
-- row set as the same query with no `order by`.

create table o (id integer primary key, flag integer);
insert into o values (1, 1), (2, 1), (3, 0);

-- =============================================================================
-- Scalar sub-select conjunct + a column comparison the module does not handle.
-- All three ordering variants must agree.
-- =============================================================================

select id from o where flag = 0 and (select max(id) from o o2) > 0;
→ [{"id":3}]

select id from o where flag = 0 and (select max(id) from o o2) > 0 order by id;
→ [{"id":3}]

select id from o where flag = 0 and (select max(id) from o o2) > 0 order by id desc;
→ [{"id":3}]

-- The filtered column in the select list: a different plan shape (the Project no
-- longer prunes `flag`), same requirement.

select id, flag from o where flag = 0 and (select max(id) from o o2) > 0;
→ [{"id":3,"flag":0}]

select id, flag from o where flag = 0 and (select max(id) from o o2) > 0 order by id;
→ [{"id":3,"flag":0}]

select id, flag from o where flag = 0 and (select max(id) from o o2) > 0 order by id desc;
→ [{"id":3,"flag":0}]

-- Written the other way round: the sub-select conjunct first.

select id from o where (select max(id) from o o2) > 0 and flag = 0 order by id;
→ [{"id":3}]

-- =============================================================================
-- EXISTS as the sub-select conjunct — same mechanism, different subquery node.
-- =============================================================================

select id from o where flag = 0 and exists (select 1 from o o2 where o2.id > 0);
→ [{"id":3}]

select id from o where flag = 0 and exists (select 1 from o o2 where o2.id > 0) order by id;
→ [{"id":3}]

select id from o where flag = 0 and exists (select 1 from o o2 where o2.id > 0) order by id desc;
→ [{"id":3}]

-- A conjunct that keeps more than one row, so a dropped predicate cannot be
-- mistaken for a correct single-row answer.

select id from o where flag = 1 and (select max(id) from o o2) > 0 order by id;
→ [{"id":1},{"id":2}]

select id from o where flag = 1 and (select max(id) from o o2) > 0 order by id desc;
→ [{"id":2},{"id":1}]

drop table o;

-- =============================================================================
-- Three-conjunct shape: two pure predicates plus a sub-select. This one loses
-- the pushed conjunct even when the filtered column IS selected.
-- k = (id-1) % 3, so k = 2 holds for ids {3,6,9,12}; v % 5 = 2 for ids {2,7,12}.
-- =============================================================================

create table t (id integer primary key, k integer, v integer);
insert into t values
  (1, 0, 1), (2, 1, 2), (3, 2, 3), (4, 0, 4), (5, 1, 5), (6, 2, 6),
  (7, 0, 7), (8, 1, 8), (9, 2, 9), (10, 0, 10), (11, 1, 11), (12, 2, 12);

select id, k from t where k = 2 and v % 5 = 2 and (select count(*) from t t2) = 12;
→ [{"id":12,"k":2}]

select id, k from t where k = 2 and v % 5 = 2 and (select count(*) from t t2) = 12 order by id;
→ [{"id":12,"k":2}]

select id, k from t where k = 2 and v % 5 = 2 and (select count(*) from t t2) = 12 order by id desc;
→ [{"id":12,"k":2}]

select id from t where (select count(*) from t t2) = 12 and k = 2 and v % 5 = 2 order by id;
→ [{"id":12}]

-- Only the pure conjunct that the module cannot claim, plus the sub-select:
-- multiple surviving rows, ascending order absorbed by the primary-key walk.

select id from t where k = 2 and (select count(*) from t t2) = 12 order by id;
→ [{"id":3},{"id":6},{"id":9},{"id":12}]

select id from t where k = 2 and (select count(*) from t t2) = 12 order by id desc;
→ [{"id":12},{"id":9},{"id":6},{"id":3}]

-- LIMIT on top of the absorbed order. LimitOffset is the other operation
-- grow-retrieve can translate into an index-style context, so it re-probes the
-- already-committed access plan; the conjunct must survive that too.

select id from t where k = 2 and (select count(*) from t t2) = 12 order by id limit 2;
→ [{"id":3},{"id":6}]

select id from t where k = 2 and (select count(*) from t t2) = 12 order by id limit 2 offset 1;
→ [{"id":6},{"id":9}]

drop table t;

-- =============================================================================
-- The mutation planner walks the same Retrieve/access-path rules, so a dropped
-- conjunct there deletes or updates rows the WHERE clause excluded.
-- =============================================================================

create table m (id integer primary key, flag integer);
insert into m values (1, 1), (2, 1), (3, 0), (4, 0);

delete from m where flag = 0 and (select max(id) from m m2) > 0;

select id, flag from m order by id;
→ [{"id":1,"flag":1},{"id":2,"flag":1}]

update m set flag = 9 where flag = 1 and (select max(id) from m m2) > 0;

select id, flag from m order by id;
→ [{"id":1,"flag":9},{"id":2,"flag":9}]

drop table m;
