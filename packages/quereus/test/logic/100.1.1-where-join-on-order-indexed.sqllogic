-- 100.1.1-where-join-on-order-indexed.sqllogic
--
-- requires-capability: standalone-index-ddl
--
-- Carved out of 100.1-where-extras: that file's subject is WHERE-predicate shapes,
-- and its reordered-ON-clause section already proves term-order equivalence without
-- any index. The one create/drop index pair below is a robustness check — "an index
-- on the ON columns must not change the answer" — not index behavior, so it moves
-- here rather than making the whole WHERE file unrunnable on a backend without
-- first-class CREATE INDEX.
--
-- Subject: a LEFT JOIN whose ON conjunction can be served by a composite index on
-- the right-hand table returns the same rows as the unindexed plan.

create table wj_l (id integer primary key, k integer);
create table wj_r (id integer primary key, k integer, tag integer);
insert into wj_l values (1, 1), (2, 2);
insert into wj_r values (10, 1, 1), (20, 1, 3), (30, 2, 1), (40, 2, 3);

-- Baseline: unindexed, both ON term orders.
select wj_l.id as lid, wj_r.id as rid from wj_l left join wj_r on wj_l.k = wj_r.k and wj_r.tag = 1 order by lid, rid;
→ [{"lid":1,"rid":10},{"lid":2,"rid":30}]

-- Index presence on the ON columns must not change results
create index wj_r_k_tag on wj_r(k, tag);

select wj_l.id as lid, wj_r.id as rid from wj_l left join wj_r on wj_l.k = wj_r.k and wj_r.tag = 1 order by lid, rid;
→ [{"lid":1,"rid":10},{"lid":2,"rid":30}]

select wj_l.id as lid, wj_r.id as rid from wj_l left join wj_r on wj_r.tag = 1 and wj_r.k = wj_l.k order by lid, rid;
→ [{"lid":1,"rid":10},{"lid":2,"rid":30}]

drop index wj_r_k_tag;
drop table wj_l;
drop table wj_r;
