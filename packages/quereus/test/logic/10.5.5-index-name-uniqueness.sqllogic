-- 10.5.5-index-name-uniqueness.sqllogic
--
-- requires-capability: standalone-index-ddl
--
-- Index names are unique per schema, not per table (docs/sql-vtab.md §6.3).
-- DROP INDEX / ALTER INDEX / sync all resolve an index by name alone, so a
-- duplicate name would resolve by table-registration order.

CREATE TABLE iu_t1 (id INTEGER PRIMARY KEY, note TEXT);
CREATE TABLE iu_t2 (id INTEGER PRIMARY KEY, note TEXT);

CREATE INDEX idx_note ON iu_t1 (note);

-- Same name, different table in the same schema: rejected, naming the owner.
CREATE INDEX idx_note ON iu_t2 (note);
-- error: Index 'idx_note' already exists in schema 'main' on table 'iu_t1'

-- Case-divergent spelling collides too (index names compare case-insensitively).
CREATE INDEX IDX_NOTE ON iu_t2 (note);
-- error: already exists in schema 'main' on table 'iu_t1'

-- IF NOT EXISTS does NOT suppress a cross-table collision: an index of that name
-- on another table is a different object, and skipping would silently leave
-- iu_t2 without the requested index.
CREATE INDEX IF NOT EXISTS idx_note ON iu_t2 (note);
-- error: Index 'idx_note' already exists in schema 'main' on table 'iu_t1'

-- ...but IF NOT EXISTS still suppresses a same-table duplicate.
CREATE INDEX IF NOT EXISTS idx_note ON iu_t1 (note);

-- A UNIQUE index occupies the same namespace as a plain one.
CREATE UNIQUE INDEX idx_note ON iu_t2 (note);
-- error: Index 'idx_note' already exists in schema 'main' on table 'iu_t1'

-- The owner is unambiguous, so DROP INDEX resolves without guessing.
DROP INDEX idx_note;

-- Freed name: the previously rejected statement now succeeds on iu_t2.
CREATE INDEX idx_note ON iu_t2 (note);

INSERT INTO iu_t2 VALUES (1, 'alpha'), (2, 'beta');
SELECT id FROM iu_t2 WHERE note = 'beta';
→ [{"id":2}]

DROP INDEX idx_note;

-- ========================================
-- Implicit covering structures are NOT in the schema-wide namespace
-- ========================================

-- A plain UNIQUE constraint's auto-built covering structure takes the
-- constraint's name, and constraint names are unique per TABLE. Two tables may
-- each declare `constraint uq_email unique (email)`.
CREATE TABLE iu_a (id INTEGER PRIMARY KEY, email TEXT, CONSTRAINT uq_email UNIQUE (email));
CREATE TABLE iu_b (id INTEGER PRIMARY KEY, email TEXT, CONSTRAINT uq_email UNIQUE (email));

-- Both constraints still enforce independently.
INSERT INTO iu_a VALUES (1, 'x@example.com');
INSERT INTO iu_b VALUES (1, 'x@example.com');

SELECT count(*) AS n FROM iu_a;
→ [{"n":1}]

INSERT INTO iu_a VALUES (2, 'x@example.com');
-- error: UNIQUE constraint

-- An ordinary CREATE INDEX may take a name held only by another table's implicit
-- covering structure — that structure is not a user object in the namespace.
CREATE TABLE iu_c (id INTEGER PRIMARY KEY, email TEXT);
CREATE INDEX uq_email ON iu_c (email);

DROP TABLE iu_c;
DROP TABLE iu_b;
DROP TABLE iu_a;
DROP TABLE iu_t2;
DROP TABLE iu_t1;
