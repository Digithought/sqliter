-- 27.3-window-json-aggregation.sqllogic
-- adapted from SQLite test/json103.test (json103-400, json103-410)
-- json_group_array() and json_group_object() used as window functions over a frame.
-- Per Quereus design (see AGENTS.md / framework notes): json_group_array and
-- json_group_object are registered via createAggregateFunction only and are not
-- invocable as window functions; the planner rejects the OVER form.

CREATE TABLE w_jagg (id INTEGER PRIMARY KEY, x TEXT);
INSERT INTO w_jagg VALUES
  (1, '1'),
  (2, 'a,b'),
  (3, '3'),
  (4, 'x"y'),
  (5, '5'),
  (6, '6'),
  (7, '7');
-- run

-- json_group_array as window aggregate is rejected
SELECT id, json_group_array(x) OVER (ORDER BY id ROWS 2 PRECEDING) as ga FROM w_jagg ORDER BY id;
-- error: Unknown window function: json_group_array

-- json_group_object as window aggregate is rejected
SELECT id, json_group_object(cast(id as text), x) OVER (ORDER BY id ROWS 2 PRECEDING) as go FROM w_jagg ORDER BY id;
-- error: Unknown window function: json_group_object

-- json_group_array with PARTITION BY also rejected
CREATE TABLE w_jagg_part (grp TEXT, val INTEGER);
INSERT INTO w_jagg_part VALUES
  ('a', 10),
  ('a', 20),
  ('a', 30),
  ('b', 100),
  ('b', 200);
-- run

SELECT grp, val, json_group_array(val) OVER (PARTITION BY grp ORDER BY val ROWS UNBOUNDED PRECEDING) as ga
FROM w_jagg_part ORDER BY grp, val;
-- error: Unknown window function: json_group_array

-- json_group_array as plain (non-window) aggregate, GROUP BY — supported
SELECT grp, json_group_array(val) as ga FROM w_jagg_part GROUP BY grp ORDER BY grp;
→ [{"grp":"a","ga":[10,20,30]},{"grp":"b","ga":[100,200]}]

DROP TABLE w_jagg;
DROP TABLE w_jagg_part;

-- Window min()/max() over a JSON column rank structurally, matching the plain
-- aggregate and ORDER BY (docs/types.md "Semantic ordering"). Canonical-text order
-- would report mn=[10], mx=[9].
CREATE TABLE w_jmm (id INTEGER PRIMARY KEY, d JSON);
INSERT INTO w_jmm VALUES (1, '[8,1]'), (2, '[9]'), (3, '[10]');
-- run

SELECT id, d FROM w_jmm ORDER BY d;
→ [{"id":1,"d":[8,1]},{"id":2,"d":[9]},{"id":3,"d":[10]}]

SELECT DISTINCT min(d) OVER () AS mn, max(d) OVER () AS mx FROM w_jmm;
→ [{"mn":[8,1],"mx":[10]}]

-- Sliding frame: each window ranks structurally on its own.
SELECT id, min(d) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS mn
FROM w_jmm ORDER BY id;
→ [{"id":1,"mn":[8,1]},{"id":2,"mn":[8,1]},{"id":3,"mn":[9]}]

DROP TABLE w_jmm;
