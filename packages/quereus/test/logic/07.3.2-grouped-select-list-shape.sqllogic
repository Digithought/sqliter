-- A grouped query returns exactly the columns in its SELECT list, in SELECT-list
-- order — nothing more, and not in GROUP BY order.
--
-- Regression for bug-grouped-aggregate-only-select-returns-extra-column. An
-- AggregateNode advertises every grouping key it computes followed by its
-- aggregate results, so whenever the planner skipped the final projection the
-- query's declared result shape became the aggregate's shape rather than the
-- select list's: `select count(*) from t group by g` handed back `g` as well as
-- the count, and a select list that named its keys in a different order than
-- GROUP BY got them back in GROUP BY order. The projection is now skipped only
-- when the two shapes already agree column for column.
--
-- Column *names and order* are asserted in test/plan/grouped-projection-shape.spec.ts
-- (row objects compare key-order-insensitively here); this file pins the values.

create table t (v integer primary key, g text null);
insert into t values (1,'a'),(2,null),(3,'b'),(4,null);

-- The original repro: select list is only an aggregate, so the grouping key must
-- not appear at all.
select count(*) as n from t group by g;
→ [{"n":1},{"n":2},{"n":1}]

select sum(v) s from t group by g;
→ [{"s":1},{"s":6},{"s":3}]

-- Unaliased aggregate keeps its expression name and stays the only column.
select count(*) from t group by g;
→ [{"count(*)":1},{"count(*)":2},{"count(*)":1}]

-- HAVING attached does not reintroduce the key.
select count(*) as n from t group by g having count(*) > 1;
→ [{"n":2}]

-- ORDER BY over the (unselected) grouping key still sorts by it.
select count(*) as n from t group by g order by g nulls first;
→ [{"n":2},{"n":1},{"n":1}]

-- Contrast: the scalar-aggregate (no GROUP BY) case was always correct.
select count(*) n from t;
→ [{"n":4}]

-- Contrast: naming the key keeps it, exactly once.
select g, count(*) c from t group by g order by g nulls first;
→ [{"g":null,"c":2},{"g":"a","c":1},{"g":"b","c":1}]

drop table t;

-- ---------------------------------------------------------------------------
-- SELECT-list order, independent of GROUP BY order. No primary key, so the
-- functional-dependency GROUP BY reduction cannot rewrite the grouping keys out
-- from under these cases.
-- ---------------------------------------------------------------------------
create table nk (a text, b text);
insert into nk values ('x','1'),('y','2');
create table u (z text);
insert into u values ('p'),('q');

-- Aggregate first, grouping key after it.
select count(*) c, a from nk group by a order by a;
→ [{"c":1,"a":"x"},{"c":1,"a":"y"}]

-- Keys named in the reverse of GROUP BY order.
select b, a, count(*) c from nk group by a, b order by a;
→ [{"b":"1","a":"x","c":1},{"b":"2","a":"y","c":1}]

-- Aggregate interleaved between two grouping keys.
select a, count(*) c, b from nk group by a, b order by a;
→ [{"a":"x","c":1,"b":"1"},{"a":"y","c":1,"b":"2"}]

-- Fewer keys named than grouped on.
select count(*) c from nk group by a, b order by a;
→ [{"c":1},{"c":1}]

-- Qualified reference to a bare grouping key is the same column.
select nk.a, count(*) c from nk group by a order by a;
→ [{"a":"x","c":1},{"a":"y","c":1}]

-- SELECT * over a grouped query with an aggregate: source-column order, then the
-- aggregate.
select *, count(*) c from nk group by a, b order by a;
→ [{"a":"x","b":"1","c":1},{"a":"y","b":"2","c":1}]

-- Grouped/ungrouped agreement: a mixed select list (named columns plus a star,
-- no aggregate) assembles star position the same way whether or not the query
-- is grouped — the ungrouped path (buildFinalProjections) and the grouped path
-- (buildFinalAggregateProjections) must agree. `group by a, b` collapses no
-- rows here (a, b together are already unique), so the two queries return the
-- same shape and values.
select b, a, * from nk order by a;
→ [{"b":"1","a":"x","a:1":"x","b:1":"1"},{"b":"2","a":"y","a:1":"y","b:1":"2"}]

select b, a, * from nk group by a, b order by a;
→ [{"b":"1","a":"x","a:1":"x","b:1":"1"},{"b":"2","a":"y","a:1":"y","b:1":"2"}]

-- Two aggregates and no named key: still no key in the output.
select count(*) c1, count(distinct b) c2 from nk group by a order by c1;
→ [{"c1":1,"c2":1},{"c1":1,"c2":1}]

-- A grouping key named twice is emitted twice — the select list is one column
-- shorter than the aggregate output here, the opposite of the leaked-key case.
select a, a, count(*) c from nk group by a order by a;
→ [{"a":"x","a:1":"x","c":1},{"a":"y","a:1":"y","c":1}]

-- An aggregate inside a scalar subquery aggregates over the *other* table, so it
-- is a non-aggregate item of this query and must not claim an aggregate slot.
select (select count(*) from u) su, count(*) c from nk group by a order by a;
→ [{"su":2,"c":1},{"su":2,"c":1}]

-- The aggregate-only grouped select composes as a derived table...
select n from (select count(*) n from nk group by a) order by n;
→ [{"n":1},{"n":1}]

-- ...as a CTE...
with c as (select count(*) n from nk group by a) select * from c;
→ [{"n":1},{"n":1}]

-- ...and as a materialized view body, where the reordered projection must still
-- carry the grouping key through as the view's unique key.
create materialized view mvn as select count(*) n, a from nk group by a;
select n, a from mvn order by a;
→ [{"n":1,"a":"x"},{"n":1,"a":"y"}]

drop materialized view mvn;

-- Contrast: an aggregate-only body has no grouping key in its output, so it is
-- genuinely unkeyed and a materialized view rejects it. Before the projection was
-- built the leaked grouping key made this body look keyed by accident.
create materialized view mvbad as select count(*) n from nk group by a;
-- error: materialized view 'main.mvbad' body produces duplicate rows

drop table u;
drop table nk;

-- ---------------------------------------------------------------------------
-- The select list survives the FD-driven GROUP BY simplification.
--
-- `rule-groupby-fd-simplification` drops a grouping column that another grouping
-- column functionally determines and re-emits it as a picker `min(<col>)`. An
-- aggregate's layout is fixed — grouping keys first, then aggregate results — so
-- the dropped column leaves the key block for the aggregate block. Each select
-- list below already agrees with the *pre-rewrite* aggregate shape, so no
-- projection is built above the aggregate and it is the query root: the shift
-- used to reach the result (bug-grouped-key-reorder-survives-to-output).
--
-- Column order is asserted in test/plan/grouped-projection-shape.spec.ts (row
-- objects compare key-order-insensitively here); this file pins the values, so a
-- picker that recovered the wrong value per group would fail here.
-- ---------------------------------------------------------------------------

-- Primary-key-driven: `v` determines `g`, so `g` is dropped and re-picked.
create table pk (v integer primary key, g text);
insert into pk values (1,'a'),(2,'b'),(3,'a');

select g, v, count(*) c from pk group by g, v order by v;
→ [{"g":"a","v":1,"c":1},{"g":"b","v":2,"c":1},{"g":"a","v":3,"c":1}]

drop table pk;

-- Equality-driven: `where a = b` puts the two grouping columns in one equivalence
-- class, so either one determines the other.
create table eqk (a text, b text);
insert into eqk values ('x','x'),('y','z'),('w','w');

select a, b, count(*) c from eqk where a = b group by a, b order by a;
→ [{"a":"w","b":"w","c":1},{"a":"x","b":"x","c":1}]

drop table eqk;

-- Join-equality-driven, with the dropped column in the middle of the select list.
create table jl (a text, b text);
create table jr (a text, c text);
insert into jl values ('x','1'),('y','2');
insert into jr values ('x','p'),('y','q');

select jl.a, jl.b, jr.a, jr.c, count(*) c from jl join jr on jl.a = jr.a
  group by jl.a, jl.b, jr.a, jr.c order by jl.a;
→ [{"a":"x","b":"1","a:1":"x","c":"p","c:1":1},{"a":"y","b":"2","a:1":"y","c":"q","c:1":1}]

drop table jl;
drop table jr;

-- The same two same-named keys with NO dependency between them (the join is on
-- the *other* pair of columns), so the FD simplification does not fire and
-- nothing caps the aggregate: it is the query root itself. Its own output names
-- must still be disambiguated the way a projection's are — a result row is
-- keyed by column name, so a repeated `a` drops one of the two values
-- (bug-duplicate-aggregate-output-names-collapse-row). The memory and store
-- modules pick different plans here, so this pins both physical aggregates.
create table dl (a text, b text);
create table dr (a text, c text);
insert into dl values ('x','p'),('y','q');
insert into dr values ('m','p'),('n','q');

select dl.a, dr.a, count(*) n from dl join dr on dl.b = dr.c group by dl.a, dr.a order by dl.a;
→ [{"a":"x","a:1":"m","n":1},{"a":"y","a:1":"n","n":1}]

drop table dl;
drop table dr;

-- `insert into … select` binds the select output by POSITION, so it is the
-- consumer the reorder actually corrupted: with the shift, `g`'s text landed in
-- `sink.v` and `v`'s integer in `sink.g`.
create table src (v integer primary key, g text);
insert into src values (1,'a'),(2,'b');
create table sink (g text, v integer, c integer);

insert into sink select g, v, count(*) from src group by g, v;
select g, v, c from sink order by v;
→ [{"g":"a","v":1,"c":1},{"g":"b","v":2,"c":1}]

-- A `union` arm is the other positional consumer: arms are matched column by
-- position, and the union's column names come from the first arm. With the shift,
-- the grouped arm contributed (v, g, c) — pairing integers against the literal
-- arm's text and vice versa.
select g, v, count(*) c from src group by g, v
union all
select 'z', 9, 1
order by v;
→ [{"g":"a","v":1,"c":1},{"g":"b","v":2,"c":1},{"g":"z","v":9,"c":1}]

-- Grouped arm second: the union's column names now come from the literal arm, so
-- a shifted grouped arm would silently file its values under the wrong names.
select 'z' g, 9 v, 1 c
union all
select g, v, count(*) from src group by g, v
order by v;
→ [{"g":"a","v":1,"c":1},{"g":"b","v":2,"c":1},{"g":"z","v":9,"c":1}]

drop table sink;
drop table src;
