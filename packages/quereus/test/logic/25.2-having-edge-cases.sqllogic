-- adapted from SQLite test/having.test
-- HAVING edge cases: predicates over aggregate results, multiple aggregates in
-- one expression, NULL-aware predicates, and rejection of non-grouped columns.

create table he (id integer primary key, grp text, val integer null);
insert into he values
  (1, 'a', 10),
  (2, 'a', 20),
  (3, 'b', null),
  (4, 'b', null),
  (5, 'c', 30),
  (6, 'c', 40);

-- HAVING with IS NULL on aggregate output
-- Group 'b' has only NULL values, so min(val) is NULL
select grp from he group by grp having min(val) is null order by grp;
→ [{"grp":"b"}]

-- HAVING with IS NOT NULL on aggregate
select grp from he group by grp having min(val) is not null order by grp;
→ [{"grp":"a"},{"grp":"c"}]

-- HAVING comparing two aggregates
-- For 'a': sum=30, avg=15 → sum > avg*2? 30 > 30 → false
-- For 'c': sum=70, avg=35 → 70 > 70 → false
-- (none qualify)
select grp from he group by grp having sum(val) > avg(val) * 2 order by grp;
→ []

-- HAVING comparing two aggregates with strict inequality
-- For 'a': sum=30 vs count(*)*5 = 10 → 30 > 10 true
-- For 'b': sum=NULL vs count(*)*5 = 10 → NULL>10 false
-- For 'c': sum=70 vs count(*)*5 = 10 → 70 > 10 true
select grp from he group by grp having sum(val) > count(*) * 5 order by grp;
→ [{"grp":"a"},{"grp":"c"}]

-- HAVING uses an aggregate alias from the SELECT list
select grp, sum(val) as total from he group by grp having total > 30 order by grp;
→ [{"grp":"c","total":70}]

-- HAVING with arithmetic on aggregates: average of squared sums per group
-- (a's sum=30, b's sum=NULL → treated as no contribution, c's sum=70)
select grp from he group by grp having sum(val) + count(*) > 35 order by grp;
→ [{"grp":"c"}]

-- HAVING that filters out the only candidate group
select grp from he group by grp having sum(val) > 1000;
→ []

drop table he;

-- =============================================================================
-- HAVING referencing a non-grouped column should be rejected
-- =============================================================================

create table hu (id integer primary key, grp text, val integer);
insert into hu values (1, 'a', 10), (2, 'a', 20);

-- HAVING referencing a non-grouped, non-aggregated column (id) is rejected.
select grp from hu group by grp having id > 0;
-- error: id

-- HAVING referencing a non-grouped column alongside an aggregate in SELECT.
select grp, sum(val) from hu group by grp having val > 0;
-- error: val

-- HAVING with a mix of grouped and ungrouped columns is rejected for the
-- ungrouped reference (the AND'd `grp` reference itself is fine).
select grp, sum(val) from hu group by grp having grp = 'a' and val > 0;
-- error: val

-- HAVING over the implicit single group (no GROUP BY, aggregate in SELECT)
-- may not reference bare columns.
select count(*) from hu having id > 0;
-- error: id

-- Positive: HAVING with an aggregate is fine.
select grp from hu group by grp having sum(val) > 0 order by grp;
→ [{"grp":"a"}]

-- Positive: HAVING with a GROUP BY column is fine.
select grp from hu group by grp having grp = 'a';
→ [{"grp":"a"}]

-- Positive: HAVING references the same expression that appears in GROUP BY
-- (fingerprint-match path). val=10 → 20, val=20 → 40; only `val=20` group qualifies.
select val * 2 as v2 from hu group by val * 2 having val * 2 > 30 order by v2;
→ [{"v2":40}]

drop table hu;

-- =============================================================================
-- HAVING with bound parameters must resolve via the parameter scope
-- =============================================================================

create table hp (id integer, grp text, val integer);
insert into hp values (1,'a',10),(2,'a',20),(3,'b',5),(4,'b',5);

-- Anonymous ? parameter in HAVING: groups with count(*) matching the bound value.
-- params: [2]
select grp from hp group by grp having count(*) = ? order by grp;
→ [{"grp":"a"},{"grp":"b"}]

-- Named parameter in HAVING: groups whose sum exceeds the bound threshold.
-- params: {"threshold":15}
select grp from hp group by grp having sum(val) > :threshold order by grp;
→ [{"grp":"a"}]

-- Anonymous ? in both WHERE and HAVING: positional indexing must span clauses.
-- WHERE keeps only val >= 10 (rows 1,2 → group 'a' count 2; group 'b' empty),
-- then HAVING count(*) = 2 selects 'a'. Mirrors the original bug-report shape.
-- params: [10, 2]
select grp from hp where val >= ? group by grp having count(*) = ? order by grp;
→ [{"grp":"a"}]

drop table hp;

-- =============================================================================
-- HAVING with NO aggregate and NO GROUP BY
--
-- Such a query is still an aggregate query: it has one implicit group over all
-- input rows, and HAVING filters that single group. It therefore yields at most
-- one row, and every clause above the aggregation is subject to the usual
-- coverage rule (only grouping columns — here, none — and aggregates).
-- Regression: the clause used to be dropped from the plan entirely, so the
-- query returned every input row unfiltered.
-- =============================================================================

create table hn (id integer primary key, grp text, val integer);
insert into hn values (1, 'x', 10), (2, 'y', 20), (3, 'x', 30);

create table hnempty (id integer primary key, val integer);

-- A bare column above the aggregation is rejected: the implicit group carries no
-- such column. The SELECT list is checked before HAVING is built, so when both name
-- an ungrouped column the SELECT-list message is the one raised -- same order as a
-- GROUP BY query, whose select list is checked at the same point.
select grp from hn having grp = 'x';
-- error: Column 'grp' must appear in the GROUP BY clause

select * from hn having grp = 'x';
-- error: Column 'id' must appear in the GROUP BY clause

-- ...including when the HAVING predicate itself is a constant, so the only ungrouped
-- reference is in the SELECT list.
select grp from hn having 1 = 0;
-- error: Column 'grp' must appear in the GROUP BY clause

select * from hn having 1 = 1;
-- error: Column 'id' must appear in the GROUP BY clause

-- With a select list that carries no bare column, HAVING's own check is what fires,
-- under its dedicated message.
select 1 as one from hn having grp = 'x';
-- error: HAVING references non-grouped column 'grp'

-- A SELECT-list alias in HAVING is not a way around the rule: it denotes the same
-- ungrouped column.
select val as v from hn having v = 10;
-- error: Column 'val' must appear in the GROUP BY clause

-- Constant-true predicate keeps the single implicit group.
select 1 as one from hn having 1 = 1;
→ [{"one":1}]

-- Constant-false predicate filters it out. (Before the fix this returned all
-- three rows of `hn`.)
select 1 as one from hn having 1 = 0;
→ []

-- The implicit group exists even over an empty table — aggregation over no rows
-- still produces exactly one group.
select 1 as one from hnempty having 1 = 1;
→ [{"one":1}]

select 1 as one from hnempty having 1 = 0;
→ []

-- A WHERE that removes every row does not remove the group either: WHERE runs below
-- the aggregation, so the implicit group is still formed over the (now empty) input.
select 1 as one from hn where val > 100 having 1 = 1;
→ [{"one":1}]

select 1 as one from hn where val > 15 having 1 = 1;
→ [{"one":1}]

-- A NULL predicate does not pass the filter, exactly as in WHERE.
select 1 as one from hn having null;
→ []

-- The shape nested as a FROM-clause subquery: the outer query sees one row or none.
select count(*) as c from (select 1 as one from hn having 1 = 1);
→ [{"c":1}]

select count(*) as c from (select 1 as one from hn having 1 = 0);
→ [{"c":0}]

-- ...and as an arm of a compound select.
select 1 as one from hn having 1 = 0 union all select 2 as one from hn having 1 = 1;
→ [{"one":2}]

-- ...and as the source of an INSERT.
create table hnsink (id integer primary key, v integer);
insert into hnsink (id, v) select 1, 1 from hn having 1 = 0;
select count(*) as c from hnsink;
→ [{"c":0}]

insert into hnsink (id, v) select 1, 1 from hn having 1 = 1;
select count(*) as c from hnsink;
→ [{"c":1}]

drop table hnsink;

-- A scalar subquery is a legal HAVING predicate here: it is not a bare column of
-- the aggregated row.
select 1 as one from hn having (select count(*) from hn) > 2;
→ [{"one":1}]

select 1 as one from hn having (select count(*) from hn) > 5;
→ []

-- Compositions above the aggregation: LIMIT, DISTINCT, ORDER BY.
select 1 as one from hn having 1 = 1 limit 1;
→ [{"one":1}]

select distinct 1 as one from hn having 1 = 1;
→ [{"one":1}]

-- ORDER BY over an ungrouped aggregate query sorts the *input* rows below the
-- aggregation (a documented Quereus extension), so naming `val` here is legal
-- and the single output row is unaffected.
select 1 as one from hn having 1 = 1 order by val;
→ [{"one":1}]

-- The same shape as a view body.
create view hnv as select 1 as one from hn having 1 = 1;
select * from hnv;
→ [{"one":1}]

drop view hnv;

-- A HAVING inside a subquery may reference an *enclosing* query's column, exactly
-- as WHERE may — that is a correlated outer reference, not an ungrouped local
-- column, and the coverage check must still tell the two apart when the subquery
-- has no aggregates at all.
select h.val from hn h where exists (select 1 from hn t having h.grp = 'x') order by h.val;
→ [{"val":10},{"val":30}]

-- A window function over the implicit group runs over the *aggregated* row, not the
-- input rows: there is exactly one, so `count(*) over ()` is 1. (Before the fix this
-- ran over all three input rows and returned 3, three times.)
select count(*) over () as c from hn having 1 = 1;
→ [{"c":1}]

-- ORDER BY by output ordinal and by select-list alias both resolve above the single
-- aggregated row. (Before the fix each returned three rows.)
select 1 as one from hn having 1 = 1 order by 1;
→ [{"one":1}]

select 1 as one from hn having 1 = 1 order by one;
→ [{"one":1}]

-- An ORDER BY may also name an AGGREGATE here. A HAVING makes this an aggregate
-- query on its own, so `count(*)` is legal in its ORDER BY exactly as it is in the
-- ORDER BY of a query that names an aggregate in its SELECT list -- the aggregate
-- is collected into the AggregateNode for the post-aggregate sort and stripped by
-- the final projection. (Before the fix, both the collection step and applyOrderBy
-- asked "does this query name an aggregate?" instead of "is this an aggregate
-- query?", so the aggregate was never collected and the sort key was rejected with
-- "Aggregate function count not allowed in this context".)
select 1 as one from hn having 1 = 1 order by count(*);
→ [{"one":1}]

-- ...with more than one sort-only aggregate, and one of a different function.
select 1 as one from hn having 1 = 1 order by count(*), max(val);
→ [{"one":1}]

-- ...and mixed with the select-list alias, which resolves on the final projection
-- while the aggregates resolve on the AggregateNode below it.
select 1 as one from hn having 1 = 1 order by count(*), one;
→ [{"one":1}]

-- A HAVING that names an aggregate beside a column-free select list. The select
-- list carries no base-table column, so nothing is uncovered and the query is a
-- plain aggregate query whose single implicit group the predicate filters.
select 1 as one from hn having count(*) > 1;
→ [{"one":1}]

select 1 as one from hn having count(*) > 5;
→ []

select 'label' as k from hn having count(*) > 1 order by count(*);
→ [{"k":"label"}]

-- ...and the same over an empty table, where the implicit group still exists but
-- its count is 0.
select 1 as one from hnempty having count(*) > 0;
→ []

select 1 as one from hnempty having count(*) = 0;
→ [{"one":1}]

-- Regression guards: adding an aggregate or a GROUP BY must not change any of the
-- long-standing behaviour.
select count(*) as c from hn having count(*) > 5;
→ []

select count(*) as c from hn having count(*) > 1;
→ [{"c":3}]

select grp, count(*) as c from hn group by grp having grp = 'x';
→ [{"grp":"x","c":2}]

select count(*) as c from hn where grp = 'x' having count(*) > 1;
→ [{"c":2}]

drop table hn;
drop table hnempty;
