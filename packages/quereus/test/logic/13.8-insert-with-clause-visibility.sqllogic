-- 13.8-insert-with-clause-visibility.sqllogic - a leading WITH on INSERT reaches every clause
--
-- `buildInsertStmt` used to build its leading `with` clause into a local map handed to
-- exactly ONE consumer — the `select` source branch — instead of deriving one
-- statement-level planning context the way `buildUpdateStmt` / `buildDeleteStmt` do. Every
-- other clause of the same statement therefore lost the statement's CTEs and failed with
-- `Table 'c' not found in schema path: main`: RETURNING, a scalar subquery inside a VALUES
-- row, ON CONFLICT, WITH CONTEXT, and the view / materialized-view target dispatch.
--
-- The same local map also started EMPTY and was filled from the INSERT's own `with` clause
-- alone, while `buildWithContext` prefers a non-empty explicit argument over the context's
-- inherited definitions — so an INSERT that carried its own `with` clause dropped every
-- definition it had inherited from an enclosing statement. That arm is covered at the end.

create table p (id integer primary key, v text);
insert into p values (1, 'a'), (2, 'b');
-- run

-- ===== RETURNING sees the statement's CTEs =====

create table q1 (id integer primary key, w text);
-- run

with c as (select id, v from p) insert into q1 values (5, 'e')
  returning id, (select count(*) from c) as n;
→ [{"id":5,"n":2}]

select id, w from q1 order by id;
→ [{"id":5,"w":"e"}]

-- ===== A scalar subquery inside a VALUES row sees them =====

create table q2 (id integer primary key, w integer);
-- run

with c as (select id from p) insert into q2 values (6, (select count(*) from c));

select id, w from q2 order by id;
→ [{"id":6,"w":2}]

-- ===== A view target sees them (source AND returning) =====

create table q3 (id integer primary key, w text);
create view vq3 as select id, w from q3;
-- run

with c as (select id, v from p) insert into vq3 select id, v from c;

select id, w from q3 order by id;
→ [{"id":1,"w":"a"},{"id":2,"w":"b"}]

with c as (select id from p) insert into vq3 values (7, 'g')
  returning id, (select count(*) from c) as n;
→ [{"id":7,"n":2}]

-- ===== A materialized-view target sees them =====

create table q4 (id integer primary key, w text);
create materialized view mvq4 as select id, w from q4;
-- run

with c as (select id, v from p) insert into mvq4 select id, v from c;

select id, w from q4 order by id;
→ [{"id":1,"w":"a"},{"id":2,"w":"b"}]

select id, w from mvq4 order by id;
→ [{"id":1,"w":"a"},{"id":2,"w":"b"}]

-- ===== Nested DML source sees them =====
-- `insert into … insert into … returning` — the inner DML builds on the same context.

create table q5 (id integer primary key, w text);
create table q5src (id integer primary key, w text);
-- run

with c as (select id from p)
insert into q5 insert into q5src values (8, 'h') returning id + (select count(*) from c), w;

select id, w from q5 order by id;
→ [{"id":10,"w":"h"}]

-- ===== An INSERT's own WITH clause does not hide the ones it INHERITED =====
-- Arm B: the inner `with c as (…)` used to replace, rather than shadow into, the enclosing
-- statement's definitions, so `a` vanished and the insert failed `Table 'a' not found`.

create table q6 (id integer primary key, w integer);
-- run

with a as (select id from p),
     b as (with c as (select 1 as k) insert into q6 select id + 40, (select k from c) from a returning id)
select count(*) as n from b;
→ [{"n":2}]

select id, w from q6 order by id;
→ [{"id":41,"w":1},{"id":42,"w":1}]

-- ===== An own-clause name still SHADOWS a same-named inherited one =====

create table q7 (id integer primary key, w integer);
-- run

with a as (select id from p),
     b as (with a as (select 77 as id) insert into q7 select id, 5 from a returning id)
select count(*) as n from b;
→ [{"n":1}]

-- 77, not 1 and 2 — the inner `a` won.
select id, w from q7 order by id;
→ [{"id":77,"w":5}]

-- ===== Control: the `select` source branch (the one that always worked) =====

create table q8 (id integer primary key, w text);
-- run

with c as (select id, v from p) insert into q8 select id + 300, v from c;

select id, w from q8 order by id;
→ [{"id":301,"w":"a"},{"id":302,"w":"b"}]

-- ===== Control: schema-authored DEFAULT expressions do NOT bind a caller's CTE =====
-- A table's own DDL is not part of the user's statement, so the statement-level CTE
-- context is deliberately withheld from column defaults / generated columns / CHECKs.
-- `c` here is a real table, and the default must keep resolving to it even when the
-- INSERT declares a CTE of the same name.

create table c (k integer primary key);
insert into c values (1), (2), (3);
create table q9 (id integer primary key, w integer default (select count(*) from c));
-- run

with c as (select id from p) insert into q9 (id) values (9);

-- 3 (the real table), not 2 (the CTE).
select id, w from q9 order by id;
→ [{"id":9,"w":3}]

-- ===== ON CONFLICT and WITH CONTEXT: name resolution is fixed, execution is not =====
-- These two clauses now RESOLVE the statement's CTEs (they no longer report
-- `Table 'c' not found`), but a subquery in either position cannot execute at all —
-- `DmlExecutorNode` does not expose its ON CONFLICT / mutation-context expressions as
-- optimizer-visible children, so their subquery subtrees are never rewritten. That is a
-- separate defect with its own root cause and reproduces with no WITH clause at all;
-- it is tracked by `fix/bug-dml-side-expressions-invisible-to-optimizer`.
--
-- Pinned here as ERRORS so this file fails loudly when that ticket lands and these
-- become real assertions.

create table q10 (id integer primary key, w text);
insert into q10 values (1, 'x');
create table mc (id integer primary key, v text) with context (who integer);
-- run

with c as (select id from p) insert into q10 values (1, 'x')
  on conflict (id) do update set w = (select count(*) from c);
-- error: No emitter registered for Aggregate

with c as (select id from p) insert into q10 values (1, 'x')
  on conflict (id) do update set w = 'y' where (select count(*) from c) > 0;
-- error: No emitter registered for Aggregate

with c as (select id from p) insert into mc with context who = (select count(*) from c)
  values (1, 'x');
-- error: No emitter registered for Aggregate

-- The same three shapes fail identically with NO leading WITH clause — the failure is
-- not about CTE visibility.
insert into q10 values (1, 'x') on conflict (id) do update set w = (select count(*) from p);
-- error: No emitter registered for Aggregate

insert into mc with context who = (select count(*) from p) values (2, 'x');
-- error: No emitter registered for Aggregate

-- Cleanup
drop materialized view mvq4;
drop view vq3;
drop table p;
drop table c;
drop table q1;
drop table q2;
drop table q3;
drop table q4;
drop table q5;
drop table q5src;
drop table q6;
drop table q7;
drop table q8;
drop table q9;
drop table q10;
drop table mc;
-- run
