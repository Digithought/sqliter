-- 07.7.7-join-source-scope-shadowing.sqllogic - an inner join's own sources must
-- shadow a same-named source in the enclosing query
--
-- Second symptom of `bug-cte-reference-as-second-join-source-fails-at-runtime`, with no
-- CTE involved and — worse — no error: it silently returned wrong rows.
--
-- A join combines its two peer source scopes with MultiScope (first match wins). Each
-- source scope used to fall back to the *enclosing* query's scope, so when MultiScope
-- asked the LEFT peer about a name the left peer did not own, it forwarded the question
-- outward and answered from there instead of letting the RIGHT peer answer. When the
-- right peer's alias also names an outer source, the inner reference bound to the OUTER
-- one — turning an uncorrelated subquery into a correlated one.
--
-- Fix: a FROM source's scope holds only its own columns; the enclosing-query fallback is
-- composed once by the consumer (ShadowScope), after both peers have been consulted.
--
-- Invariant pinned here: the subquery below is uncorrelated (its `x` is its own `t1`), so
-- `n` is the same constant on every outer row. Pre-fix it returned 3, 3, 0.
--
-- The second half of the file pins the other side of the same invariant: peers-first is
-- not peers-only. An ON condition must still reach the enclosing query for a correlated
-- column or a bind parameter — the fallback moved one level later, it did not go away.

create table t1 (id integer primary key, v integer);
insert into t1 values (1, 10), (2, 20), (3, 30);

create table t2 (id integer primary key, v integer);
insert into t2 values (1, 100), (2, 200);

-- =============================================================================
-- Inner join's RIGHT peer aliased the same as an outer source. `x.id` inside the
-- subquery must be the inner `t1 as x`, giving 2 matches on every outer row.
-- =============================================================================

select x.id, (select count(*) from t2 join t1 as x on x.id = t2.id) as n
from t1 as x order by x.id;
→ [{"id":1,"n":2},{"id":2,"n":2},{"id":3,"n":2}]

-- Operand-swapped condition — `x.id` is looked up second rather than first.

select x.id, (select count(*) from t2 join t1 as x on t2.id = x.id) as n
from t1 as x order by x.id;
→ [{"id":1,"n":2},{"id":2,"n":2},{"id":3,"n":2}]

-- Non-key join column, so the join is not answered by a primary-key seek.

select x.id, (select count(*) from t2 join t1 as x on x.v = t2.v) as n
from t1 as x order by x.id;
→ [{"id":1,"n":0},{"id":2,"n":0},{"id":3,"n":0}]

-- =============================================================================
-- Same shape with the inner LEFT peer an inline subquery source, which builds its
-- scope on a separate code path (the `subquerySource` branch of buildFrom).
-- =============================================================================

select x.id, (select count(*) from (select id from t2) s join t1 as x on x.id = s.id) as n
from t1 as x order by x.id;
→ [{"id":1,"n":2},{"id":2,"n":2},{"id":3,"n":2}]

-- The inline subquery on the RIGHT instead: the outer `s` must not capture `s.id`.

select s.id, (select count(*) from t1 as x join (select id from t2) s on x.id = s.id) as n
from t1 as s order by s.id;
→ [{"id":1,"n":2},{"id":2,"n":2},{"id":3,"n":2}]

-- =============================================================================
-- A genuinely correlated subquery over the same alias names still correlates —
-- the fix must not sever the enclosing-scope fallback, only reorder it after the
-- join's own peers. `outer_t.id` is not a name either inner peer owns.
-- =============================================================================

select outer_t.id,
       (select count(*) from t2 join t1 as x on x.id = t2.id where x.id = outer_t.id) as n
from t1 as outer_t order by outer_t.id;
→ [{"id":1,"n":1},{"id":2,"n":1},{"id":3,"n":0}]

-- LATERAL still sees the left peer's columns from the right peer's body.

select l.id, r.doubled from t1 as l
cross join lateral (select l.v * 2 as doubled) as r
order by l.id;
→ [{"id":1,"doubled":20},{"id":2,"doubled":40},{"id":3,"doubled":60}]

-- =============================================================================
-- Reaching PAST both peers from an ON condition. Own-only peer scopes mean the
-- MultiScope of the two peers answers "no" for everything the join does not own,
-- so the ON condition's own context has to carry the enclosing-query fallback
-- itself (ShadowScope([MultiScope([left, right]), outerScope]) in buildJoin).
-- Without it nothing outside the join resolves in an ON clause at all.
-- =============================================================================

-- Qualified correlated outer column.

select o.id, (select count(*) from t2 join t1 as x on x.id = t2.id and x.id = o.id) as n
from t1 as o order by o.id;
→ [{"id":1,"n":1},{"id":2,"n":1},{"id":3,"n":0}]

-- Unqualified correlated outer column, owned by neither peer. When both peers
-- chained to the enclosing scope, BOTH answered with the same outer symbol and
-- MultiScope called it "ambiguous column name: ov".

select o.id, (select count(*) from t2 join t1 as x on x.id = t2.id and x.v = ov) as n
from (select id, v as ov from t1) as o order by o.id;
→ [{"id":1,"n":1},{"id":2,"n":1},{"id":3,"n":0}]

-- A bind parameter in an ON condition — resolved by the ParameterScope in the
-- enclosing chain, not by either peer. Positional order still counts the ON
-- clause's `?` before the WHERE clause's.

-- params: [2, 30]
select x.id from t2 join t1 as x on x.id = t2.id and t2.id = ? where x.v <> ?
order by x.id;
→ [{"id":2}]

-- A scalar subquery inside an ON condition, correlated to the join's own LEFT peer.

select t2.id as a, x.id as b from t2
join t1 as x on x.id = (select max(t1b.id) from t1 as t1b where t1b.id = t2.id)
order by t2.id;
→ [{"a":1,"b":1},{"a":2,"b":2}]

-- Three-way join: the outer join's ON reaches past a peer that is itself a join.

select o.id, (select count(*) from t2 join t1 as x on x.id = t2.id
              join t1 as y on y.id = x.id and y.id = o.id) as n
from t1 as o order by o.id;
→ [{"id":1,"n":1},{"id":2,"n":1},{"id":3,"n":0}]

-- Ambiguity between the two peers is still ambiguity: the enclosing fallback sits
-- BEHIND the MultiScope, so it must not answer after MultiScope has said "ambiguous".
-- `v` is owned by both peers here, and also by the enclosing `o`.

select o.id, (select count(*) from t1 join t2 on v = 100) as n from t1 as o;
-- error: ambiguous column name: v

drop table t2;
drop table t1;
