-- generated-columns.sqllogic - Testing GENERATED ALWAYS AS computed columns

-- === STORED Generated Columns ===

-- Basic STORED generated column (use integers to avoid floating point)
CREATE TABLE t_gen_stored (
    id INTEGER PRIMARY KEY,
    base_price INTEGER NOT NULL,
    multiplier INTEGER NOT NULL DEFAULT 2,
    total_price INTEGER GENERATED ALWAYS AS (base_price * multiplier) STORED
);

-- INSERT with generated column computed automatically (named columns)
INSERT INTO t_gen_stored (id, base_price, multiplier) VALUES (1, 100, 3);
SELECT id, base_price, multiplier, total_price FROM t_gen_stored WHERE id = 1;
→ [{"id":1,"base_price":100,"multiplier":3,"total_price":300}]

-- INSERT with default multiplier
INSERT INTO t_gen_stored (id, base_price) VALUES (2, 200);
SELECT id, total_price FROM t_gen_stored WHERE id = 2;
→ [{"id":2,"total_price":400}]

-- UPDATE triggers recomputation of stored generated column
UPDATE t_gen_stored SET base_price = 50 WHERE id = 1;
SELECT id, base_price, total_price FROM t_gen_stored WHERE id = 1;
→ [{"id":1,"base_price":50,"total_price":150}]

-- UPDATE multiplier also triggers recomputation
UPDATE t_gen_stored SET multiplier = 5 WHERE id = 1;
SELECT id, total_price FROM t_gen_stored WHERE id = 1;
→ [{"id":1,"total_price":250}]

-- Cannot INSERT into generated column (explicit column list)
INSERT INTO t_gen_stored (id, base_price, multiplier, total_price) VALUES (3, 100, 2, 999);
-- error: Cannot INSERT into generated column 'total_price'

-- Cannot UPDATE a generated column
UPDATE t_gen_stored SET total_price = 999 WHERE id = 1;
-- error: Cannot UPDATE generated column 'total_price'

-- SELECT * includes generated columns
SELECT * FROM t_gen_stored WHERE id = 2;
→ [{"id":2,"base_price":200,"multiplier":2,"total_price":400}]

DROP TABLE t_gen_stored;

-- === STORED generated column with string concatenation ===

CREATE TABLE t_gen_concat (
    id INTEGER PRIMARY KEY,
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    full_name TEXT GENERATED ALWAYS AS (first_name || ' ' || last_name) STORED
);

INSERT INTO t_gen_concat (id, first_name, last_name) VALUES (1, 'John', 'Doe');
SELECT full_name FROM t_gen_concat WHERE id = 1;
→ [{"full_name":"John Doe"}]

UPDATE t_gen_concat SET first_name = 'Jane' WHERE id = 1;
SELECT full_name FROM t_gen_concat WHERE id = 1;
→ [{"full_name":"Jane Doe"}]

DROP TABLE t_gen_concat;

-- === Interaction with NOT NULL ===

CREATE TABLE t_gen_notnull (
    id INTEGER PRIMARY KEY,
    a INTEGER NULL,
    b INTEGER GENERATED ALWAYS AS (a * 2) STORED NOT NULL
);

-- NULL input causes generated column to be NULL, violating NOT NULL
INSERT INTO t_gen_notnull (id, a) VALUES (1, NULL);
-- error: NOT NULL constraint failed: t_gen_notnull.b

-- Non-null input succeeds
INSERT INTO t_gen_notnull (id, a) VALUES (1, 5);
SELECT b FROM t_gen_notnull WHERE id = 1;
→ [{"b":10}]

DROP TABLE t_gen_notnull;

-- === Interaction with CHECK constraints ===

CREATE TABLE t_gen_check (
    id INTEGER PRIMARY KEY,
    price INTEGER NOT NULL,
    discount INTEGER NOT NULL DEFAULT 0,
    final_price INTEGER GENERATED ALWAYS AS (price - discount) STORED,
    CHECK (final_price >= 0)
);

-- Valid: final_price = 100 - 10 = 90
INSERT INTO t_gen_check (id, price, discount) VALUES (1, 100, 10);
SELECT final_price FROM t_gen_check WHERE id = 1;
→ [{"final_price":90}]

-- Invalid: final_price = 50 - 100 = -50 violates CHECK
INSERT INTO t_gen_check (id, price, discount) VALUES (2, 50, 100);
-- error: CHECK constraint failed

DROP TABLE t_gen_check;

-- === Cannot have both DEFAULT and GENERATED ===

CREATE TABLE t_gen_default_err (
    id INTEGER PRIMARY KEY,
    a INTEGER DEFAULT 5 GENERATED ALWAYS AS (id * 2) STORED
);
-- error: cannot have both DEFAULT and GENERATED

-- === Multiple generated columns ===

CREATE TABLE t_gen_multi (
    id INTEGER PRIMARY KEY,
    a INTEGER NOT NULL,
    b INTEGER NOT NULL,
    sum_ab INTEGER GENERATED ALWAYS AS (a + b) STORED,
    diff_ab INTEGER GENERATED ALWAYS AS (a - b) STORED
);

INSERT INTO t_gen_multi (id, a, b) VALUES (1, 10, 3);
SELECT sum_ab, diff_ab FROM t_gen_multi WHERE id = 1;
→ [{"sum_ab":13,"diff_ab":7}]

UPDATE t_gen_multi SET a = 20 WHERE id = 1;
SELECT sum_ab, diff_ab FROM t_gen_multi WHERE id = 1;
→ [{"sum_ab":23,"diff_ab":17}]

DROP TABLE t_gen_multi;

-- === RETURNING with generated columns ===

CREATE TABLE t_gen_returning (
    id INTEGER PRIMARY KEY,
    x INTEGER NOT NULL,
    y INTEGER GENERATED ALWAYS AS (x * x) STORED
);

INSERT INTO t_gen_returning (id, x) VALUES (1, 5) RETURNING id, x, y;
→ [{"id":1,"x":5,"y":25}]

UPDATE t_gen_returning SET x = 7 WHERE id = 1 RETURNING id, y;
→ [{"id":1,"y":49}]

DROP TABLE t_gen_returning;

-- === VIRTUAL Generated Columns ===
-- Note: VIRTUAL columns currently behave like STORED (storage optimization deferred).
-- The semantic behavior is correct: cannot INSERT/UPDATE, expression is evaluated.

CREATE TABLE t_gen_virtual (
    id INTEGER PRIMARY KEY,
    width INTEGER NOT NULL,
    height INTEGER NOT NULL,
    area INTEGER GENERATED ALWAYS AS (width * height) VIRTUAL
);

-- INSERT computes the virtual column
INSERT INTO t_gen_virtual (id, width, height) VALUES (1, 5, 10);
SELECT id, width, height, area FROM t_gen_virtual WHERE id = 1;
→ [{"id":1,"width":5,"height":10,"area":50}]

-- Cannot INSERT into virtual column
INSERT INTO t_gen_virtual (id, width, height, area) VALUES (2, 3, 4, 99);
-- error: Cannot INSERT into generated column 'area'

-- Cannot UPDATE virtual column
UPDATE t_gen_virtual SET area = 100 WHERE id = 1;
-- error: Cannot UPDATE generated column 'area'

-- UPDATE recalculates virtual column
UPDATE t_gen_virtual SET width = 8 WHERE id = 1;
SELECT area FROM t_gen_virtual WHERE id = 1;
→ [{"area":80}]

-- Default VIRTUAL (no STORED/VIRTUAL keyword defaults to VIRTUAL per SQL standard)
CREATE TABLE t_gen_default_mode (
    id INTEGER PRIMARY KEY,
    x INTEGER NOT NULL,
    doubled INTEGER GENERATED ALWAYS AS (x * 2)
);

INSERT INTO t_gen_default_mode (id, x) VALUES (1, 7);
SELECT doubled FROM t_gen_default_mode WHERE id = 1;
→ [{"doubled":14}]

DROP TABLE t_gen_default_mode;
DROP TABLE t_gen_virtual;

-- ============================================================
-- === Row-scope spellings: one meaning at every write site ===
--
-- A `generated always as (...)` body is compiled by four different statements —
-- the INSERT row expansion, the `on conflict do update` recompute, the UPDATE
-- recompute, and the `alter table ... add column` backfill. All four go through
-- one builder (`planner/building/generated-column-scope.ts`), so a declaration
-- the engine accepts is one every subsequent write accepts.
--
-- Accepted: bare `col`, `table.col`, `schema.table.col`, `new.col`.
-- Rejected: `old.col` (see 41-generated-column-errors.sqllogic) and any other
-- qualifier. The ALTER arms live in
-- 41.13-alter-add-column-generated-backfill.sqllogic.
-- ============================================================

-- --- bare `col` ---

create table t_spell_bare (id integer primary key, a integer,
	g integer generated always as (a * 2) stored);
insert into t_spell_bare (id, a) values (1, 1);
select id, a, g from t_spell_bare order by id;
→ [{"id":1,"a":1,"g":2}]

update t_spell_bare set a = 5 where id = 1;
select id, a, g from t_spell_bare order by id;
→ [{"id":1,"a":5,"g":10}]

insert into t_spell_bare (id, a) values (1, 9) on conflict (id) do update set a = 9;
select id, a, g from t_spell_bare order by id;
→ [{"id":1,"a":9,"g":18}]

drop table t_spell_bare;

-- --- `table.col` — the body qualifies its own table ---

create table t_spell_tbl (id integer primary key, a integer,
	g integer generated always as (t_spell_tbl.a * 2) stored);
insert into t_spell_tbl (id, a) values (1, 1);
select id, a, g from t_spell_tbl order by id;
→ [{"id":1,"a":1,"g":2}]

update t_spell_tbl set a = 5 where id = 1;
select id, a, g from t_spell_tbl order by id;
→ [{"id":1,"a":5,"g":10}]

insert into t_spell_tbl (id, a) values (1, 9) on conflict (id) do update set a = 9;
select id, a, g from t_spell_tbl order by id;
→ [{"id":1,"a":9,"g":18}]

drop table t_spell_tbl;

-- --- `schema.table.col` — the body qualifies its own schema and table ---

create table t_spell_sch (id integer primary key, a integer,
	g integer generated always as (main.t_spell_sch.a * 2) stored);
insert into t_spell_sch (id, a) values (1, 1);
select id, a, g from t_spell_sch order by id;
→ [{"id":1,"a":1,"g":2}]

update t_spell_sch set a = 5 where id = 1;
select id, a, g from t_spell_sch order by id;
→ [{"id":1,"a":5,"g":10}]

insert into t_spell_sch (id, a) values (1, 9) on conflict (id) do update set a = 9;
select id, a, g from t_spell_sch order by id;
→ [{"id":1,"a":9,"g":18}]

drop table t_spell_sch;

-- --- `new.col` — an exact alias for the bare form ---

create table t_spell_new (id integer primary key, a integer,
	g integer generated always as (new.a * 2) stored);
insert into t_spell_new (id, a) values (1, 1);
select id, a, g from t_spell_new order by id;
→ [{"id":1,"a":1,"g":2}]

update t_spell_new set a = 5 where id = 1;
select id, a, g from t_spell_new order by id;
→ [{"id":1,"a":5,"g":10}]

insert into t_spell_new (id, a) values (1, 9) on conflict (id) do update set a = 9;
select id, a, g from t_spell_new order by id;
→ [{"id":1,"a":9,"g":18}]

drop table t_spell_new;

-- --- `new.<other generated column>` sees the freshly computed value ---
-- The generated columns are computed in dependency order, so g2 reads g1's new
-- value, not the NULL placeholder the row expansion starts from.

create table t_spell_chain (id integer primary key, a integer,
	g1 integer generated always as (a * 2) stored,
	g2 integer generated always as (new.g1 + 1) stored);
insert into t_spell_chain (id, a) values (1, 5);
select id, a, g1, g2 from t_spell_chain order by id;
→ [{"id":1,"a":5,"g1":10,"g2":11}]

update t_spell_chain set a = 10 where id = 1;
select id, a, g1, g2 from t_spell_chain order by id;
→ [{"id":1,"a":10,"g1":20,"g2":21}]

insert into t_spell_chain (id, a) values (1, 3) on conflict (id) do update set a = 3;
select id, a, g1, g2 from t_spell_chain order by id;
→ [{"id":1,"a":3,"g1":6,"g2":7}]

drop table t_spell_chain;

-- --- a real table named `new` is still reachable from a generated body ---
-- `new` is not a reserved word. The row scope is an ANCESTOR of every subquery
-- planned inside the body, so the subquery's own FROM binds the name first and
-- `"new".a` reads the table, not the row being written.

create table "new" (a integer primary key);
insert into "new" values (7);

create table t_spell_newtbl (id integer primary key,
	g integer generated always as ((select max("new".a) from "new")) stored);
insert into t_spell_newtbl (id) values (1);
select id, g from t_spell_newtbl order by id;
→ [{"id":1,"g":7}]

drop table t_spell_newtbl;
drop table "new";

-- --- a mutation-context variable does NOT shadow a column here ---
-- In a CHECK or a column DEFAULT a `with context` variable claims the bare name.
-- A generated body is different on purpose: its value is a pure function of the
-- row being written and must compute identically at all four sites, and the
-- `alter table ... add column` backfill has no context envelope to read. So the
-- bare name always means the column. `g` below is a + 1 = 4, NOT ctx + 1 = 101.

create table t_spell_ctx (id integer primary key, a integer,
	g integer generated always as (a + 1) stored) with context (a integer);
insert into t_spell_ctx (id, a) values (1, 3) with context a = 100;
select id, a, g from t_spell_ctx order by id;
→ [{"id":1,"a":3,"g":4}]

drop table t_spell_ctx;

-- --- the row's columns resolve at their DECLARED type, so a declared COLLATE
-- --- applies inside the body — identically at all three write sites ---
-- The shared builder resolves each column reference against
-- `columnSchemaToScalarType(column)`, which carries the column's declared
-- collation, rather than against the type of whatever expression produced the
-- row attribute. A `collate nocase` column therefore compares case-insensitively
-- inside a generated body, the same way it does in a CHECK and on the read path.

create table t_spell_coll (id integer primary key, a text collate nocase,
	g integer generated always as (case when a = 'ABC' then 1 else 0 end) stored);

insert into t_spell_coll (id, a) values (1, 'abc');
select id, a, g from t_spell_coll order by id;
→ [{"id":1,"a":"abc","g":1}]

update t_spell_coll set a = 'AbC' where id = 1;
select id, g from t_spell_coll order by id;
→ [{"id":1,"g":1}]

insert into t_spell_coll (id, a) values (1, 'zzz') on conflict (id) do update set a = 'ABc';
select id, g from t_spell_coll order by id;
→ [{"id":1,"g":1}]

-- a value the collation does NOT equate still yields 0, so the arm is not vacuous
update t_spell_coll set a = 'abd' where id = 1;
select id, g from t_spell_coll order by id;
→ [{"id":1,"g":0}]

drop table t_spell_coll;
