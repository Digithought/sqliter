-- Scope-aware reference analysis for GENERATED ALWAYS AS expressions.
--
-- A name in a generated expression resolves against the table being defined unless a
-- FROM clause inside the expression binds it — the same rule a CHECK constraint
-- follows. The dependency analysis (extractGeneratedColumnDependencies) and the ALTER
-- ADD COLUMN pre-flight (validateAddColumnGeneratedRefs) share one scope-aware
-- collector (src/schema/generated-column-refs.ts), so a subquery's own FROM sources
-- bind their columns and the owning table neither falsely rejects the name nor
-- records a false dependency edge. Genuine typos and genuine cycles still raise the
-- same errors as before.

-- ===================================
-- 1. Subquery over another table, inner name UNQUALIFIED — accepted, correct value.
--    (Previously: "Column 'v' referenced by generated column 'g' not found in table 't'".)
-- ===================================

create table d (k integer primary key, v integer);
insert into d values (1, 42);

create table t (
	id integer primary key,
	g integer generated always as ((select v from d where d.k = id limit 1))
);
insert into t (id) values (1);

select id, g from t;
→ [{"id":1,"g":42}]

drop table t;
drop table d;

-- ===================================
-- 2. Two generated columns each reading ANOTHER table's like-named column —
--    no false cycle, both values correct.
-- ===================================

create table d2 (k integer primary key, w integer, g integer);
insert into d2 values (1, 10, 20);

create table t2 (
	id integer primary key,
	w integer generated always as ((select g from d2 where d2.k = id limit 1)),
	g integer generated always as ((select w from d2 where d2.k = id limit 1))
);
insert into t2 (id) values (1);

select id, w, g from t2;
→ [{"id":1,"w":20,"g":10}]

drop table t2;
drop table d2;

-- ===================================
-- 3. Generated column whose subquery selects another table's column with the SAME
--    name as itself — no false self-cycle.
-- ===================================

create table l0 (k integer primary key, g integer);
insert into l0 values (1, 7);

create table l1 (
	id integer primary key,
	g integer generated always as ((select g from l0 where l0.k = id limit 1))
);
insert into l1 (id) values (1);

select id, g from l1;
→ [{"id":1,"g":7}]

drop table l1;
drop table l0;

-- ===================================
-- 4. Common table expression binds the inner name — accepted.
-- ===================================

create table j1 (
	id integer primary key,
	g integer generated always as ((with c(v) as (select 7) select v from c))
);
insert into j1 (id) values (1);

select id, g from j1;
→ [{"id":1,"g":7}]

drop table j1;

-- ===================================
-- 5. Aliased self source: the alias binds the subquery's FROM, so the inner bare `a`
--    is that source's column, not the row being computed. Nullable because the
--    subquery finds no row while the table is still empty.
-- ===================================

create table s1 (
	id integer primary key,
	a integer,
	g integer null generated always as ((select a from s1 x where x.id = 1 limit 1))
);
insert into s1 (id, a) values (1, 5);
insert into s1 (id, a) values (2, 6);

select id, g from s1 order by id;
→ [{"id":1,"g":null},{"id":2,"g":5}]

drop table s1;

-- ===================================
-- 6. A real table named "new": the FROM binding wins over the row-image reading
--    (`new` is not a reserved word).
-- ===================================

create table "new" (a integer primary key);
insert into "new" values (3);

create table tn (
	id integer primary key,
	g integer generated always as ((select max("new".a) from "new"))
);
insert into tn (id) values (1);

select id, g from tn;
→ [{"id":1,"g":3}]

drop table tn;
drop table "new";

-- ===================================
-- 7. Subquery over the table's OWN pre-insert rows — the in-flight column set
--    answers for the table before the catalog holds it. Nullable: the subquery
--    sees no rows while inserting the first one.
-- ===================================

create table own1 (
	id integer primary key,
	g integer null generated always as ((select max(id) from own1))
);
insert into own1 (id) values (5);

select id, g from own1;
→ [{"id":5,"g":null}]

drop table own1;

-- ===================================
-- 8. Dependency edges survive the scope awareness: an unrebound `new.<col>` and a
--    schema-qualified self reference both bind the owning row, so DROP COLUMN of the
--    referenced column is still refused.
-- ===================================

create table tnew (id integer primary key, a integer, g integer generated always as (new.a * 2));
alter table tnew drop column a;
-- error: Cannot drop column 'a' from 'tnew': it is referenced by generated column 'g'
drop table tnew;

create table sq3 (id integer primary key, a integer, g integer generated always as (main.sq3.a + 1));
alter table sq3 drop column a;
-- error: Cannot drop column 'a' from 'sq3': it is referenced by generated column 'g'
drop table sq3;

-- A qualifier naming ANOTHER schema is not a self reference even though the bare
-- names collide — and nothing else binds it either, so CREATE TABLE rejects the
-- declaration up front (see 41-generated-column-errors.sqllogic § 4).
create table sqm (id integer primary key, a integer, g integer generated always as ("temp".sqm.a + 1));
-- error: binds nothing

-- ===================================
-- 9. The name a subquery's FROM binds is a reference to THAT table, so the
--    cross-table column guards see it: dropping the referenced column is refused,
--    and renaming it rewrites the generated body (the value still computes).
-- ===================================

create table dref (k integer primary key, v integer);
insert into dref values (1, 42);
create table tref (id integer primary key, g integer generated always as ((select v from dref where dref.k = id limit 1)));

alter table dref drop column v;
-- error: Cannot drop column 'v' from 'dref': it is referenced by the GENERATED expression of column 'g' on table 'tref'

alter table dref rename column v to v2;
-- run

insert into tref (id) values (1);
select id, g from tref;
→ [{"id":1,"g":42}]

drop table tref;
drop table dref;

-- ===================================
-- 10. An inner name that ALSO names a column of the table being defined belongs to
--     the subquery's source — analysis and evaluation agree on that reading.
-- ===================================

create table dsh (k integer primary key, id integer);
insert into dsh values (1, 99);

create table tsh (id integer primary key);
insert into tsh values (1);
alter table tsh add column h integer generated always as ((select id from dsh where dsh.k = 1 limit 1));
-- run

insert into tsh (id) values (7);
select id, h from tsh order by id;
→ [{"id":1,"h":99},{"id":7,"h":99}]

drop table tsh;
drop table dsh;

-- ===================================
-- 11. Negative arms — genuine mistakes still raise the original messages.
-- ===================================

create table n1 (id integer primary key, g integer generated always as (nosuch + 1));
-- error: Column 'nosuch' referenced by generated column 'g' not found in table 'n1'

-- A typo INSIDE a subquery whose FROM does not expose the name is still a typo.
create table dz (k integer primary key);
create table nz (id integer primary key, g integer generated always as ((select nosuch from dz limit 1)));
-- error: Column 'nosuch' referenced by generated column 'g' not found in table 'nz'
drop table dz;

create table n2 (id integer primary key);
alter table n2 add column g integer generated always as (g + 1);
-- error: Cyclic dependency in generated columns: 'g'
drop table n2;

create table n3 (
	id integer primary key,
	a integer generated always as (b + 1),
	b integer generated always as (a + 1)
);
-- error: Cyclic dependency in generated columns

-- An unrebound `new.` names the row being computed, so an unknown name behind it is a
-- typo like any other. (Behavior change: this was accepted at DDL time before the
-- scope-aware analysis and only failed at the first write.)
create table n4 (id integer primary key, g integer generated always as (new.nosuch + 1));
-- error: Column 'nosuch' referenced by generated column 'g' not found in table 'n4'

-- ===================================
-- 12. An unbound qualifier reached only through an OPAQUE frame (a derived
--     table's body) is undecidable, not rejected. The walk cannot see what such
--     a body binds, so it defers rather than refusing a declaration it cannot
--     prove wrong — contrast 41-generated-column-errors.sqllogic § 4, where no
--     opaque frame intervenes and CREATE TABLE rejects up front. Documented
--     residual (see the NOTE in src/schema/generated-column-refs.ts): the
--     declaration is accepted and the first write is what reports the name.
-- ===================================

create table dop (k integer primary key, v integer);

create table sop (
	id integer primary key,
	a integer,
	g integer generated always as ((select y from (select zz.v as y from dop) s limit 1))
);

drop table sop;
drop table dop;

-- ===================================
-- 13. Each leg of a compound builds its OWN FROM scope: a bare name in the second
--     leg is NOT captured by the first leg's sources. Here `cs_src` exposes a
--     column named `b` and the second leg's source does not, so the second leg's
--     bare `b` binds the row being computed — which means `g` depends on `b` and
--     must be computed after it. `g` is declared FIRST, so declaration order alone
--     would compute it while `b` is still null; only the recorded dependency edge
--     gets the right value. (Before the compound legs were split out of the
--     leading leg's frame, `b` read as `cs_src`'s column, no edge was recorded,
--     `g` computed against `b`'s NULL placeholder, and the insert failed
--     `NOT NULL constraint failed: cs.g` — verified by reverting the split.)
-- ===================================

create table cs_src (k integer primary key, b integer);
insert into cs_src values (1, 999);

create table cs_probe (k integer primary key);
insert into cs_probe values (1);

create table cs (
	id integer primary key,
	g integer generated always as ((select b from cs_src where 1 = 0 union all select b from cs_probe where k = 1)),
	b integer generated always as (id * 10)
);
insert into cs (id) values (7);

select id, g, b from cs;
→ [{"id":7,"g":70,"b":70}]

drop table cs;
drop table cs_probe;
drop table cs_src;

-- ===================================
-- 14. View write-through metadata inside a generated body records NO dependency
--     edge. `with inverse (…)` on a result column and a trailing `with defaults (…)`
--     are evaluated against the row written THROUGH A VIEW — an inverse expression
--     may only name that select's OWN output columns as `new.<column>` — so nothing
--     in them can name the row being computed here, and in a read-only generated
--     body they are never evaluated at all. Both bodies below spell a name that is
--     ALSO the generated column being defined; classifying a sealed reference as
--     undecidable instead would record a self-edge and raise a false
--     `Cyclic dependency in generated columns: 'g'`.
-- ===================================

create table gi_src (k integer primary key, x integer);
insert into gi_src values (1, 5);

create table gi (
	id integer primary key,
	g integer generated always as ((select x as g with inverse (x = new.g) from gi_src limit 1))
);
insert into gi (id) values (2);

select id, g from gi;
→ [{"id":2,"g":5}]

create table gd (
	id integer primary key,
	g integer generated always as ((select x from gi_src limit 1 with defaults (x = g)))
);
insert into gd (id) values (3);

select id, g from gd;
→ [{"id":3,"g":5}]

drop table gd;
drop table gi;
drop table gi_src;
