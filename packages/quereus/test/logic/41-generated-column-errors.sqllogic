-- adapted from SQLite test/gencol1.test
-- Generated-column error / rejection paths.

-- ===================================
-- 1. Self-referencing generated column rejected
-- ===================================

create table t_self (
	id integer primary key,
	a integer generated always as (a + 1) stored
);
-- error:
drop table if exists t_self;

-- ===================================
-- 2. Mutually-recursive generated columns rejected
-- ===================================

create table t_cycle (
	id integer primary key,
	c0 integer not null,
	c1 integer generated always as (c0 + c2) stored,
	c2 integer generated always as (c1) stored
);
-- error:
drop table if exists t_cycle;

-- ===================================
-- 3. DROP COLUMN of a column referenced by a GENERATED expression rejected
-- ===================================

create table t_drop (
	id integer primary key,
	a integer not null,
	b integer generated always as (a * 2) stored
);

insert into t_drop (id, a) values (1, 5);

-- 'a' is referenced by generated column 'b'
alter table t_drop drop column a;
-- error:

-- dropping the generated column itself should succeed
alter table t_drop drop column b;

select id, a from t_drop where id = 1;
→ [{"id":1,"a":5}]

drop table t_drop;

-- ===================================
-- 4. `old.<col>` rejected in a generated expression, at every write site
--
-- A generated value is computed from the row being WRITTEN; there is no old row
-- to compute it from. The bare, `<table>.`, `<schema>.<table>.` and `new.`
-- spellings all resolve (see 41-generated-columns.sqllogic); `old.` resolves
-- nowhere, and reports the same thing whichever statement compiles the body.
-- ===================================

create table t_old (id integer primary key, a integer,
	g integer generated always as (old.a + 1) stored);

-- INSERT row expansion
insert into t_old (id, a) values (1, 3);
-- error: old.a isn't a column

-- `on conflict ... do update` recompute
insert into t_old (id, a) values (1, 3) on conflict (id) do update set a = 1;
-- error: old.a isn't a column

-- UPDATE recompute (rejected at plan time, so no rows are needed)
update t_old set a = 1 where id = 1;
-- error: old.a isn't a column

drop table t_old;

-- `alter table ... add column` backfill
create table t_old_alter (id integer primary key, a integer);
insert into t_old_alter values (1, 3);

alter table t_old_alter add column g integer generated always as (old.a + 1);
-- error: old.a isn't a column

-- the rejected ALTER left the table alone
select id, a from t_old_alter order by id;
→ [{"id":1,"a":3}]

drop table t_old_alter;
