-- 03.9.1-is-bool-predicate-partial-index.sqllogic — `IS [NOT] TRUE/FALSE` inside a partial-index WHERE.
--
-- requires-capability: standalone-index-ddl
--
-- Carved out of 03.9-is-bool-predicate: that file's subject is the four postfix
-- boolean-test predicates themselves (totality over NULL, isTruthy routing,
-- precedence, CHECK usage), none of which needs an index. This one block used
-- standalone `create index ... where` only as a second compilation site for the
-- same operators, so a backend without first-class CREATE INDEX would have lost
-- the whole predicate file over it.
--
-- Subject: all four operators must compile in a partial-index WHERE clause
-- (exercises compileUnary in vtab/memory/utils/predicate.ts), and queries must
-- stay correct regardless of which rows the index covers.

create table feat (id integer primary key, name text, flag any null);
insert into feat values (1, 'alpha', true);
insert into feat values (2, 'beta', false);
insert into feat values (3, 'gamma', null);
insert into feat values (4, 'delta', true);

create index ix_feat_t  on feat(name) where flag is true;
create index ix_feat_nt on feat(name) where flag is not true;
create index ix_feat_f  on feat(name) where flag is false;
create index ix_feat_nf on feat(name) where flag is not false;

-- Re-query through the now-indexed table; results must be unchanged.
select id from feat where flag is true order by id;
→ [{"id":1},{"id":4}]

select id from feat where flag is false order by id;
→ [{"id":2}]

drop table feat;
