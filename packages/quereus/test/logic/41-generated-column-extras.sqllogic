-- adapted from SQLite test/gencol1.test
-- Generated-column scenarios beyond 41-generated-columns.sqllogic.

-- ===================================
-- 1. Chain — generated column referencing another generated column
-- ===================================

create table t_chain (
	id integer primary key,
	a integer not null,
	m integer generated always as (a * 2) stored,
	w integer generated always as (m * 5) stored
);

insert into t_chain (id, a) values (1, 3);

select a, m, w from t_chain where id = 1;
→ [{"a":3,"m":6,"w":30}]

update t_chain set a = 4 where id = 1;

select a, m, w from t_chain where id = 1;
→ [{"a":4,"m":8,"w":40}]

drop table t_chain;

-- ===================================
-- 1b. Reverse-declaration-order chain — `w` declared before its dependency `m`
-- ===================================

create table t_chain_rev (
	id integer primary key,
	a integer not null,
	w integer generated always as (m * 5) stored,
	m integer generated always as (a * 2) stored
);

insert into t_chain_rev (id, a) values (1, 3);

select a, m, w from t_chain_rev where id = 1;
→ [{"a":3,"m":6,"w":30}]

update t_chain_rev set a = 4 where id = 1;

select a, m, w from t_chain_rev where id = 1;
→ [{"a":4,"m":8,"w":40}]

drop table t_chain_rev;

-- ===================================
-- 2. Generated column used in WHERE / ORDER BY / GROUP BY
-- ===================================

create table t_q (
	id integer primary key,
	a integer not null,
	b integer not null,
	s integer generated always as (a + b) stored
);

insert into t_q (id, a, b) values (1, 1, 2), (2, 3, 1), (3, 2, 2);

-- WHERE on generated column
select id from t_q where s = 4 order by id;
→ [{"id":2},{"id":3}]

-- GROUP BY on generated column
select s, count(*) as n from t_q group by s order by s;
→ [{"s":3,"n":1},{"s":4,"n":2}]

-- ORDER BY on generated column
select id, s from t_q order by s desc, id;
→ [{"id":2,"s":4},{"id":3,"s":4},{"id":1,"s":3}]

drop table t_q;

-- ===================================
-- 3. Type coercion via generated column
-- ===================================

create table t_typed (
	id integer primary key,
	c any null,
	t text generated always as (typeof(c)) stored
);

insert into t_typed (id, c) values (1, 5), (2, 'abc'), (3, 5.5), (4, null);

select id, t from t_typed order by id;
→ [{"id":1,"t":"integer"},{"id":2,"t":"text"},{"id":3,"t":"real"},{"id":4,"t":"null"}]

drop table t_typed;

-- ===================================
-- 4. Generated column with UNIQUE constraint
-- ===================================

create table t_u (
	id integer primary key,
	a integer not null,
	b integer generated always as (a * 10) stored unique
);

insert into t_u (id, a) values (1, 1), (2, 2);

-- duplicate generated value should violate UNIQUE
insert into t_u (id, a) values (3, 1);
-- error: UNIQUE

drop table t_u;

-- ===================================
-- 5. Generated column as PRIMARY KEY
-- ===================================

create table t_pk (
	a integer not null,
	k integer generated always as (a + 100) stored primary key
);

insert into t_pk (a) values (1);

-- duplicate generated PK value should fail
insert into t_pk (a) values (1);
-- error:

select k from t_pk;
→ [{"k":101}]

drop table t_pk;

-- ===================================
-- 6. Generated column whose expression is a scalar subquery
--    (deterministic within a statement, but the evaluator resolves ASYNCHRONOUSLY —
--     UPDATE's generated-column recompute must await it, not store the Promise)
-- ===================================

create table t_src (k integer primary key);

insert into t_src values (1), (2), (3);

create table t_sub (
	id integer primary key,
	w  integer,
	g  integer generated always as ((select count(*) from t_src))
);

insert into t_sub (id, w) values (1, 1), (2, 2);

select id, w, g from t_sub order by id;
→ [{"id":1,"w":1,"g":3},{"id":2,"w":2,"g":3}]

-- updating an unrelated column re-runs the generated expression
update t_sub set w = 5 where id = 1;

select id, w, g from t_sub order by id;
→ [{"id":1,"w":5,"g":3},{"id":2,"w":2,"g":3}]

-- the subquery's source changes: a later update must recompute, not carry the old value
insert into t_src values (4), (5);

update t_sub set w = 6 where id = 1;

select id, w, g from t_sub order by id;
→ [{"id":1,"w":6,"g":5},{"id":2,"w":2,"g":3}]

-- multi-row update (no WHERE) — exercises phase-2 context teardown across iterations
update t_sub set w = w + 10;

select id, w, g from t_sub order by id;
→ [{"id":1,"w":16,"g":5},{"id":2,"w":12,"g":5}]

drop table t_sub;
drop table t_src;

-- ===================================
-- 7. Chain across the async path — a generated column feeding another
-- ===================================

create table t_src2 (k integer primary key);

insert into t_src2 values (1), (2);

create table t_sub_chain (
	id integer primary key,
	w  integer,
	g  integer generated always as ((select count(*) from t_src2)) stored,
	g2 integer generated always as (g * 2) stored
);

insert into t_sub_chain (id, w) values (1, 1);

select w, g, g2 from t_sub_chain;
→ [{"w":1,"g":2,"g2":4}]

insert into t_src2 values (3);

update t_sub_chain set w = 9 where id = 1;

select w, g, g2 from t_sub_chain;
→ [{"w":9,"g":3,"g2":6}]

drop table t_sub_chain;
drop table t_src2;
