-- ALTER-path minted constraint-name disambiguation.
--
-- The ALTER counterpart of 10.1.4 (which covers the CREATE TABLE mints). A
-- constraint the user does not name gets an invented name, and that name is the
-- handle `ALTER TABLE … DROP CONSTRAINT <name>` addresses — so it has to address
-- exactly ONE constraint. Every ALTER spelling that mints a name therefore
-- disambiguates against the names already on the table:
--
--   * `ADD FOREIGN KEY (...)`      → `_fk_<table>_<cols>`, `_<N>` suffix on collision
--   * `ADD COLUMN … references …`  → same mint, same suffix
--   * `ADD CHECK (...)`            → `check_<n>`, n bumped upward until free
--
-- `check_<n>` bumps its INDEX rather than taking a `_<N>` suffix (which would read
-- `check_1_2`); n starts at the number of CHECKs already on the table, which is
-- the historical spelling, so every non-colliding name is byte-identical to what
-- the engine minted before (§5 pins that).
--
-- A constraint the USER names and that collides keeps being refused (§6) — that is
-- identity, not a mint.
--
-- No `-- requires-capability:` directive, so this runs under both the memory
-- module and the store module. The store leg matters: disambiguated names are
-- persisted and must survive a reopen.

pragma foreign_keys = true;

-- ===================================================================
-- 1. `ALTER TABLE … ADD FOREIGN KEY` onto a column that already carries an
--    unnamed FK: minted `_fk_AmC_x_2`, each key addressable and each dropping
--    only itself. (Before the fix both were `_fk_AmC_x`, so one DROP silently
--    removed both and the orphan insert below was accepted.)
-- ===================================================================

create table AmP1 (x integer primary key);
create table AmP2 (y integer primary key);
create table AmC (id integer primary key, x integer null references AmP1(x));

select name from foreign_key_info('AmC') order by name;
→ [{"name":"_fk_AmC_x"}]

alter table AmC add foreign key (x) references AmP2(y);
select name, "to" from foreign_key_info('AmC') order by name;
→ [{"name":"_fk_AmC_x","to":"x"},{"name":"_fk_AmC_x_2","to":"y"}]

-- Both keys enforce, each under its own name (FK existence checks share the
-- `CHECK constraint failed:` prefix — see runtime/row-constraints.ts).
-- A value present in AmP1 but not AmP2 trips only the ALTER-added key…
insert into AmP1 values (1);
insert into AmC values (1, 1);
-- error: CHECK constraint failed: _fk_AmC_x_2

-- …a value present in AmP2 but not AmP1 trips only the CREATE-time key…
insert into AmP2 values (2);
insert into AmC values (1, 2);
-- error: CHECK constraint failed: _fk_AmC_x

-- …and a value present in both parents is accepted.
insert into AmP1 values (7);
insert into AmP2 values (7);
insert into AmC values (1, 7);
select count(*) as c from AmC;
→ [{"c":1}]

-- Dropping the CREATE-time key removes ONLY it.
alter table AmC drop constraint _fk_AmC_x;
select name from foreign_key_info('AmC');
→ [{"name":"_fk_AmC_x_2"}]

-- The ALTER-added key still enforces (1 ∉ AmP2) — the enforcement half of the
-- defect, which a name-only assertion would miss.
insert into AmC values (2, 1);
-- error: CHECK constraint failed: _fk_AmC_x_2

-- …while a value only AmP2 holds is now accepted (the dropped key no longer binds).
insert into AmP2 values (9);
insert into AmC values (3, 9);
select count(*) as c from AmC;
→ [{"c":2}]

-- And the survivor is itself addressable by its disambiguated name.
alter table AmC drop constraint _fk_AmC_x_2;
select count(*) as c from foreign_key_info('AmC');
→ [{"c":0}]
insert into AmC values (4, 12345);
select count(*) as c from AmC;
→ [{"c":3}]

-- ===================================================================
-- 2. `ALTER TABLE … ADD COLUMN … references …`: two inline FKs on ONE new
--    column mint `_fk_AcC_x` / `_fk_AcC_x_2`, exactly as the CREATE TABLE
--    spelling of the same declaration does.
-- ===================================================================

create table AcP1 (x integer primary key);
create table AcP2 (y integer primary key);
create table AcC (id integer primary key);

alter table AcC add column x integer null references AcP1(x) references AcP2(y);
select name, "to" from foreign_key_info('AcC') order by name;
→ [{"name":"_fk_AcC_x","to":"x"},{"name":"_fk_AcC_x_2","to":"y"}]

insert into AcP1 values (3);
insert into AcC values (1, 3);
-- error: CHECK constraint failed: _fk_AcC_x_2

alter table AcC drop constraint _fk_AcC_x_2;
insert into AcC values (1, 3);
select count(*) as c from AcC;
→ [{"c":1}]

-- ===================================================================
-- 3. ADD COLUMN revert drops by the name the module actually stored.
--
--    The engine pre-builds each inline FK (to reject a collation conflict before
--    the module call) and remembers that FK's name as the one to hand back if a
--    LATER inline constraint fails. If the engine's mint and the module's mint
--    disambiguated against different sets, the revert would drop a name that was
--    never installed and strand the real constraint on a column that is about to
--    disappear — under a DISAMBIGUATED name, which is exactly the case this file
--    creates. Here the first inline FK installs and the second is rejected, so the
--    whole ALTER must leave the table exactly as it was.
--
--    The rejection trigger is a child/parent COLLATION conflict rather than an
--    existing-row FK orphan, because the collation check is engine-side and
--    unconditional, so this case runs identically on every backend. (The orphan
--    trigger does not fire on the Lamina backend, which replays this corpus —
--    tracked in that repo as `bug-add-constraint-admits-orphan-rows`.) The first
--    FK's parent column has a DEFAULTED binary collation, which is the engine
--    floor and resolves against the child's declared NOCASE; the second FK's
--    parent DECLARES binary, and two declarations at the same rank conflict.
-- ===================================================================

create table RvP1 (id integer primary key, x text unique);
create table RvP2 (id integer primary key, y text collate binary unique);
create table RvC (id integer primary key);
insert into RvC values (1);

alter table RvC add column x text null collate nocase references RvP1(x) references RvP2(y);
-- error: conflicting collations

-- Column gone, both keys gone — nothing stranded.
select count(*) as c from table_info('RvC');
→ [{"c":1}]
select count(*) as c from foreign_key_info('RvC');
→ [{"c":0}]

-- ===================================================================
-- 4. `ALTER TABLE … ADD CHECK (...)`: a drop shrinks the CHECK count, so the
--    next unnamed add would re-mint a LIVE `check_<n>`. The index is bumped
--    past it instead. (Before the fix the third add below re-minted `check_1`,
--    and `alter table Ckm drop constraint check_1` then switched off BOTH the
--    `a < 100` rule and the `a <> 7` rule.)
-- ===================================================================

create table Ckm (id integer primary key, a integer null);

alter table Ckm add check (a > 0);
alter table Ckm add check (a < 100);
select name from check_constraint_info('Ckm') order by name;
→ [{"name":"check_0"},{"name":"check_1"}]

alter table Ckm drop constraint check_0;
alter table Ckm add check (a <> 7);
select name from check_constraint_info('Ckm') order by name;
→ [{"name":"check_1"},{"name":"check_2"}]

-- Both survivors enforce, each under its own name.
insert into Ckm values (1, 200);
-- error: check_1

insert into Ckm values (2, 7);
-- error: check_2

-- The dropped lower bound no longer binds.
insert into Ckm values (3, -1);
select count(*) as c from Ckm;
→ [{"c":1}]

-- Dropping `check_1` releases ONLY the upper bound; `check_2` still rejects 7.
alter table Ckm drop constraint check_1;
insert into Ckm values (4, 200);
select count(*) as c from Ckm;
→ [{"c":2}]

insert into Ckm values (5, 7);
-- error: check_2

-- ===================================================================
-- 5. Non-colliding mints are unchanged (pins the compatibility property).
--
--    The index is seeded from the CHECK COUNT, not from the lowest free index,
--    so a table whose existing CHECK is user-named still mints `check_1` for the
--    first unnamed add — byte-identical to the historical spelling, even though
--    `check_0` happens to be free.
-- ===================================================================

create table CkU (id integer primary key, a integer null, constraint ck_user check (a > -100));
alter table CkU add check (a > 0);
select name from check_constraint_info('CkU') order by name;
→ [{"name":"check_1"},{"name":"ck_user"}]

-- A lone ALTER-added FK onto a table with no constraint of that name keeps the
-- bare mint.
create table SoloP (x integer primary key);
create table SoloC (id integer primary key, x integer null);
alter table SoloC add foreign key (x) references SoloP(x);
select name from foreign_key_info('SoloC');
→ [{"name":"_fk_SoloC_x"}]

-- ===================================================================
-- 6. A name the USER writes is identity, not a mint: a collision is still
--    refused rather than disambiguated.
-- ===================================================================

alter table CkU add constraint ck_user check (a < 5);
-- error: already exists

select count(*) as c from check_constraint_info('CkU');
→ [{"c":2}]
