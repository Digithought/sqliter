-- where-conjunct-ordering.sqllogic - WHERE conjunct cost ordering end-to-end
-- Complements test/where-conjunct-ordering.spec.ts (which owns the evaluation
-- counts and plan-shape assertions via a counting UDF). This file pins row-set
-- parity: `rule-filter-conjunct-ordering` reorders a Filter's AND conjuncts
-- cheapest-first, and that must NEVER change which rows a query returns — for
-- both written orders of each query, NULL conjuncts, the `v <> 0` guard idiom,
-- a HAVING conjunction, and the three-valued-logic truth table.

-- 13 rows: k = (id-1) % 3, v = id except the last row's v = 0 (the guard-idiom
-- divisor). k = 2 holds for ids {3,6,9,12}; v % 5 = 2 for ids {2,7,12}.
create table t (id integer primary key, k integer, v integer);
insert into t values
  (1, 0, 1), (2, 1, 2), (3, 2, 3), (4, 0, 4), (5, 1, 5), (6, 2, 6),
  (7, 0, 7), (8, 1, 8), (9, 2, 9), (10, 0, 10), (11, 1, 11), (12, 2, 12),
  (13, 0, 0);

-- =============================================================================
-- Both written orders of a subquery + pure-arithmetic conjunction return the
-- same rows (the subquery conjunct is reordered last; results must not move).
-- =============================================================================

select id from t where (select length('x')) = 1 and v % 5 = 2 order by id;
→ [{"id":2},{"id":7},{"id":12}]

select id from t where v % 5 = 2 and (select length('x')) = 1 order by id;
→ [{"id":2},{"id":7},{"id":12}]

select id from t where (select count(*) from t) = 13 and k = 2 and v % 5 = 2 order by id;
→ [{"id":12}]

select id from t where k = 2 and v % 5 = 2 and (select count(*) from t) = 13 order by id;
→ [{"id":12}]

-- =============================================================================
-- NULL conjuncts: a Filter rejects on NULL exactly as on false, in either
-- position, so both orders return zero rows.
-- =============================================================================

select id from t where null and k = 2;
→ []

select id from t where k = 2 and null;
→ []

-- =============================================================================
-- Guard idiom: `v <> 0` protecting a division. Sound in either order (division
-- by zero yields NULL, which the Filter rejects), and cost ordering keeps the
-- simpler guard first anyway. Pinned so a future cost-model change cannot
-- silently break it. 10 / v <= 10 holds for every v >= 1.
-- =============================================================================

select id from t where v <> 0 and 10 / v <= 10 order by id;
→ [{"id":1},{"id":2},{"id":3},{"id":4},{"id":5},{"id":6},{"id":7},{"id":8},{"id":9},{"id":10},{"id":11},{"id":12}]

select id from t where 10 / v <= 10 and v <> 0 order by id;
→ [{"id":1},{"id":2},{"id":3},{"id":4},{"id":5},{"id":6},{"id":7},{"id":8},{"id":9},{"id":10},{"id":11},{"id":12}]

-- =============================================================================
-- HAVING conjunctions build FilterNodes too, so the rule applies there as well.
-- k = 0 has 5 rows, k = 1 and k = 2 have 4 each.
-- =============================================================================

select k, count(*) as c from t group by k having count(*) >= 4 and k > 0 order by k;
→ [{"k":1,"c":4},{"k":2,"c":4}]

select k, count(*) as c from t group by k having k > 0 and count(*) >= 4 order by k;
→ [{"k":1,"c":4},{"k":2,"c":4}]

-- =============================================================================
-- Three-valued logic under reordering: `a and b` vs `b and a` over every
-- {true,false,null}² pair. A Filter keeps a row only when the conjunction is
-- true, and AND is commutative under 3VL, so both orders keep exactly the rows
-- where both operands are true.
-- =============================================================================

create table tv (id integer primary key, a integer null, b integer null);
insert into tv values
  (1, 1, 1), (2, 1, 0), (3, 1, null),
  (4, 0, 1), (5, 0, 0), (6, 0, null),
  (7, null, 1), (8, null, 0), (9, null, null);

select id from tv where a and b order by id;
→ [{"id":1}]

select id from tv where b and a order by id;
→ [{"id":1}]

-- =============================================================================
-- Selectivity-driven ordering (ANALYZEd table): within one cost tier the rule
-- now runs the conjunct that statistics say rejects more rows per unit work
-- first. `weak` has 2 distinct values, `strong` 50, so `strong in (2, 3)`
-- (est. 0.04) sorts ahead of `weak = 1` (est. 0.5) despite the pricier IN list.
-- Row-set parity for both written orders is what this file can pin; the plan
-- order itself is asserted in test/where-conjunct-ordering.spec.ts.
-- weak = id % 2, strong = id % 50 → the conjunction keeps ids {3, 53}.
-- =============================================================================

create table sel (id integer primary key, weak integer, strong integer);
insert into sel values
  (1, 1, 1), (2, 0, 2), (3, 1, 3), (4, 0, 4), (5, 1, 5), (6, 0, 6), (7, 1, 7), (8, 0, 8), (9, 1, 9), (10, 0, 10),
  (11, 1, 11), (12, 0, 12), (13, 1, 13), (14, 0, 14), (15, 1, 15), (16, 0, 16), (17, 1, 17), (18, 0, 18), (19, 1, 19), (20, 0, 20),
  (21, 1, 21), (22, 0, 22), (23, 1, 23), (24, 0, 24), (25, 1, 25), (26, 0, 26), (27, 1, 27), (28, 0, 28), (29, 1, 29), (30, 0, 30),
  (31, 1, 31), (32, 0, 32), (33, 1, 33), (34, 0, 34), (35, 1, 35), (36, 0, 36), (37, 1, 37), (38, 0, 38), (39, 1, 39), (40, 0, 40),
  (41, 1, 41), (42, 0, 42), (43, 1, 43), (44, 0, 44), (45, 1, 45), (46, 0, 46), (47, 1, 47), (48, 0, 48), (49, 1, 49), (50, 0, 0),
  (51, 1, 1), (52, 0, 2), (53, 1, 3), (54, 0, 4), (55, 1, 5), (56, 0, 6), (57, 1, 7), (58, 0, 8), (59, 1, 9), (60, 0, 10),
  (61, 1, 11), (62, 0, 12), (63, 1, 13), (64, 0, 14), (65, 1, 15), (66, 0, 16), (67, 1, 17), (68, 0, 18), (69, 1, 19), (70, 0, 20),
  (71, 1, 21), (72, 0, 22), (73, 1, 23), (74, 0, 24), (75, 1, 25), (76, 0, 26), (77, 1, 27), (78, 0, 28), (79, 1, 29), (80, 0, 30),
  (81, 1, 31), (82, 0, 32), (83, 1, 33), (84, 0, 34), (85, 1, 35), (86, 0, 36), (87, 1, 37), (88, 0, 38), (89, 1, 39), (90, 0, 40),
  (91, 1, 41), (92, 0, 42), (93, 1, 43), (94, 0, 44), (95, 1, 45), (96, 0, 46), (97, 1, 47), (98, 0, 48), (99, 1, 49), (100, 0, 0);

analyze sel;

select id from sel where weak = 1 and strong in (2, 3) order by id;
→ [{"id":3},{"id":53}]

select id from sel where strong in (2, 3) and weak = 1 order by id;
→ [{"id":3},{"id":53}]

drop table sel;
drop table tv;
drop table t;
